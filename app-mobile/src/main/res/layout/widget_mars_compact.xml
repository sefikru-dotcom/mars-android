<?xml version="1.0" encoding="utf-8"?>
<!--
    Виджет «Марс — Быстрый ввод и голос» (компактная полоса 3x1 / 4x1).

    Одна строка, пять зон — весь путь «спросить Марса» без открытия приложения:
      * планета слева — список диалогов (ChatSessionsActivity);
      * капсула «Спросить Марс…» — открывает чат и сразу поднимает клавиатуру;
      * микрофон — открывает чат и сразу включает диктовку;
      * динамик — живой голосовой режим Орба: полноэкранный разговор сразу,
        без промежуточного экрана чата (пятая кнопка волны 21);
      * звезда в тёмном рубиновом ореоле — новый чистый диалог.

    Высота 56dp: на домашнем экране это ровно одна ячейка. Кнопки 32dp с паддингом
    8dp по краям карточки дают тап-цель выше минимальных 48dp по площади, а капсула
    ввода забирает всё оставшееся место (layout_weight=1) — на 4x1 это ~90dp текста,
    на минимальных 3x1 капсула ужимается и обрезает подсказку многоточием, но ни одна
    кнопка не уезжает за границу.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mars_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_compact_planet"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/widget_mars_sessions"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mars" />

    <TextView
        android:id="@+id/widget_compact_input"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_mars_input_pill"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_mars_compose_hint"
        android:textColor="@color/mars_muted"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/widget_compact_mic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_mars_action_btn"
        android:contentDescription="@string/widget_mars_action_voice"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic"
        android:tint="@color/mars_text_em" />

    <!-- Живой разговор с Орбом: тап открывает полноэкранный голосовой режим сразу. -->
    <ImageButton
        android:id="@+id/widget_compact_voice_mode"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_mars_action_btn"
        android:contentDescription="@string/widget_mars_action_voice_mode"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume"
        android:tint="@color/mars_text_em" />

    <ImageButton
        android:id="@+id/widget_compact_star"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_mars_star_btn"
        android:contentDescription="@string/widget_mars_action_new_chat"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_send"
        android:tint="@color/mars_accent_text" />

</LinearLayout>
