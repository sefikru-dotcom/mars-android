<?xml version="1.0" encoding="utf-8"?>
<!--
    Первый кадр виджета: его рисует лаунчер ДО первого onUpdate, поэтому здесь
    только название и нота — без кнопок, которые в этот момент ещё ни на что не
    нажимаются.

    Отдельный layout обязателен: initialLayout из music_widget_info.xml должен
    существовать и не зависеть от состояния плеера (RemoteViews с кликами по
    несуществующим PendingIntent система отбросила бы).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/music_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/music_widget_cover_bg"
        android:contentDescription="@string/music_widget_cover"
        android:scaleType="centerInside"
        android:src="@drawable/ic_music" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/music_widget_label"
        android:textColor="@color/mars_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
