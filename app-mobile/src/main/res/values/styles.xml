<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Базовая тема приложения.

        Что здесь принципиально:
        * windowBackground — брендовый фон, а не цвет. Окно рисует первый кадр
          ДО onCreate любой Activity, поэтому именно эта строка отвечает за то,
          что при старте не мелькает чёрный прямоугольник.
        * forceDarkAllowed=false — HyperOS (POCO F5) включает принудительный
          «тёмный режим» для приложений, которые система считает светлыми, и
          перекрашивает цвета. Клиент уже тёмный: инверсия ломала палитру
          (рубиновый акцент уходил в розовый, #07080B — в серый). Флаг
          выключает автодарк для всего приложения.
        * windowLayoutInDisplayCutoutMode=shortEdges — контент уходит под вырез
          камеры; иначе на POCO F5 сверху остаётся полоса фона поверх картинки.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/mars_accent</item>
        <item name="android:navigationBarColor">@color/mars_background</item>
        <item name="android:statusBarColor">@color/mars_background</item>
        <item name="android:windowBackground">@drawable/mars_window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- API 29+: на 28 атрибут просто игнорируется, поэтому
             tools:targetApi гасит NewApi, не заводя второй копии темы. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Стартовая тема заставки: до первого кадра Activity окно уже должно быть
         брендовым, иначе между тапом по иконке и onCreate виден системный
         чёрный/дефолтный фон. Родитель — AppTheme, чтобы шрифт, бары и акцент
         остались общими; переопределяется только фон.
         API 31+ перекрывает эту тему своей версией (values-v31/styles.xml). -->
    <style name="SplashTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/splash_window_bg</item>
    </style>
</resources>
