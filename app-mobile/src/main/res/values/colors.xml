<?xml version="1.0" encoding="utf-8"?>
<!--
    Mars Design System — единый источник цвета для XML-слоя клиента.

    Правила, которые держит этот файл (и проверяет scripts/theme-parity-audit.py):

    * Hex живёт ТОЛЬКО здесь и в MarsTheme.kt / MarsGradients.kt. Любой
      `0xff...` в экране — дефект: гейт падает на нём же.
    * Имена общие с app-tv: один бренд — один токен. Значения одноимённых
      токенов сверяет scripts/theme-parity-audit.py (режим parity); до этой
      сверки user_border и bot_border разъехались между модулями
      (2A354D / 2B374E, 1A2130 / 1B2230), и пузырь чата на телефоне и на
      телевизоре имел разную рамку.
    * Значения совпадают с MarsTheme.kt (Kotlin-палитра — источник истины):
      colors.xml нужен только там, где цвет обязателен в XML (темы, иконки,
      layer-list'ы).
-->
<resources>
    <!-- ===================== Base surfaces ===================== -->
    <color name="mars_background">#07080B</color>
    <color name="mars_sidebar">#0C0E14</color>
    <color name="mars_surface">#10131B</color>
    <color name="mars_surface_subtle">#141822</color>
    <color name="mars_surface_card">#161B28</color>

    <!-- ===================== Borders ===================== -->
    <color name="mars_border">#212634</color>
    <color name="mars_border_subtle">#171C26</color>
    <color name="mars_border_muted">#283042</color>
    <!-- Тонкая рамка всплывающих поверхностей (диалоги, шиты). -->
    <color name="mars_border_dialog">#1E2433</color>

    <!-- ===================== Accent Ruby Mars ===================== -->
    <color name="mars_accent">#EF4444</color>
    <color name="mars_accent_hover">#F87171</color>
    <color name="mars_accent_bg">#26EF4444</color>
    <color name="mars_accent_bg_pressed">#33EF4444</color>
    <color name="mars_accent_border">#33EF4444</color>
    <color name="mars_accent_text">#FCA5A5</color>
    <!-- Текст на акцентной заливке (кнопка «отправить», primary-CTA). -->
    <color name="mars_on_accent">#0B0D12</color>
    <!-- Стандартный 20% white ripple для интерактивных поверхностей. -->
    <color name="mars_ripple">#33FFFFFF</color>

    <!-- ===================== Typography ===================== -->
    <color name="mars_text">#F1F5F9</color>
    <color name="mars_text_strong">#FFFFFF</color>
    <!-- Историческое имя того же тона; оставлено, чтобы не ломать ссылки. -->
    <color name="mars_strong">#FFFFFF</color>
    <color name="mars_muted">#8B95A5</color>
    <color name="mars_em">#CBD5E1</color>
    <!-- Алиас имени, которым этот же тон зовёт app-tv (mars_text_em). -->
    <color name="mars_text_em">#CBD5E1</color>
    <!-- Монохромная иконка по умолчанию: векторы красятся tint'ом на месте. -->
    <color name="mars_icon">#FFFFFF</color>

    <!-- ===================== Chat ===================== -->
    <color name="mars_user_bubble">#1C2436</color>
    <color name="mars_user_border">#2B374E</color>
    <color name="mars_bot_card">#0F121A</color>
    <color name="mars_bot_border">#1B2230</color>
    <!-- Подложка цитаты: тот же тон, что у inline-кода. -->
    <color name="mars_quote_bg">#141822</color>
    <!-- Вертикальный бар цитаты (View слева от текста). -->
    <color name="mars_quote_bar">#EF4444</color>
    <!-- Горизонтальный разделитель блоков: View 1dp, не глиф. -->
    <color name="mars_divider">#212634</color>

    <!-- ===================== Code & Terminal ===================== -->
    <color name="mars_code_bg">#090B10</color>
    <color name="mars_code_border">#1C2331</color>
    <color name="mars_code_text">#F8FAFC</color>
    <color name="mars_code_tag">#38BDF8</color>

    <!-- ===================== Thoughts (reasoning accordion) ===================== -->
    <color name="mars_thought_bg">#143B82F6</color>
    <color name="mars_thought_border">#333B82F6</color>

    <!-- ===================== Statuses ===================== -->
    <color name="mars_status_online">#22C55E</color>
    <color name="mars_status_error">#EF4444</color>
    <color name="mars_status_warning">#F59E0B</color>
    <color name="mars_status_info">#38BDF8</color>

    <!-- ===================== Chrome / overlays ===================== -->
    <!-- Затемнение под модальными поверхностями (85% базового фона). -->
    <color name="mars_scrim">#D907080B</color>
    <!-- Подложка иконки системного сплэша (API 31+). -->
    <color name="mars_splash_icon_bg">#161B28</color>
    <!-- Вуаль поверх фонового кадра: сверху почти прозрачно, снизу плотно.
         values-night/colors.xml перекрывает эти два токена системной темой. -->
    <color name="mars_bg_scrim_top">#00000000</color>
    <color name="mars_bg_scrim_bottom">#8C07080B</color>
    <!-- Виньетка кадра: центр прозрачный, края уходят в обсидиан. Гасит
         светлые углы на широких экранах, где кадр растянут по горизонтали.
         Inner держим полностью прозрачным: плотное кольцо не должно
         подступать к лимбу планеты — это главный светлый акцент кадра. -->
    <color name="mars_bg_vignette_inner">#0007080B</color>
    <color name="mars_bg_vignette_outer">#6607080B</color>
    <!-- Стеклянные поверхности mobile — те же токены и те же значения, что у
         app-tv (mars_glass_fill / _focused / _stroke): один бренд, один токен,
         и theme-parity-audit сверяет их значения между модулями.

         Плотность 69% — не вкус, а замер. Худший пиксель кадра — яркий лимб
         #FFCC6C; после слоя окна (62%) и вуали он даёт #6C5833, и стекло на
         нём держит mars_muted 4.83:1 (порог AA). При 55% тот же текст падает
         до 3.94:1 — читаемость теряется ровно там, где карточка лежит на
         освещённой части планеты. -->
    <color name="mars_glass_fill">#B010131B</color>
    <color name="mars_glass_fill_focused">#CC161C28</color>
    <color name="mars_glass_stroke">#33FFFFFF</color>
    <!-- Приглушённый текст НА стекле: обычный mars_muted (#8B95A5) на
         полупрозрачной подложке даёт 4.8 на ярком лимбе, а этот тон — 5.9.
         Тот же приём и то же значение, что на TV. -->
    <color name="mars_muted_on_glass">#9AA5B4</color>
    <!-- Экранная вуаль поверх кадра: 55% обсидиана ПОД контентом.
         Зачем, если окно уже приглушает кадр до 62%: текст в экране лежит не
         только в карточках, но и прямо на фоне (подписи шапки, статус-строки,
         чипы подсказок). На самом ярком участке лимба такой приглушённый текст
         даёт 2.25:1 — нечитаемо. С этой вуалью (42%) стеклянная карточка на
         лимбе держит 4.64:1, основной текст — 12.8:1, а кадр остаётся живым
         (планета видна, а не залита). -->
    <color name="mars_screen_veil">#6B07080B</color>
</resources>
