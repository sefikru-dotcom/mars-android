<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Фирменная звезда Марса на кнопке отправки — паритет с `mars-send-star` WebUI.
        Пять слоёв снизу вверх: мягкое многослойное свечение ореола (два полупрозрачных
        круга), наклонённое орбитальное кольцо, четырёхлучевая звезда и яркое ядро.
        Альфы намеренно разные: tint кнопки (SRC_IN) сохраняет альфу, поэтому даже
        в монохромном белом варианте звезда читается объёмно, а не плоской кляксой.
        Свечение рисуется ВНУТРИ иконки, а не заливкой кнопки: тёмный ореол кнопки
        (MarsTheme.SEND_HALO_BG) остаётся тёмным, а вокруг звезды появляется тёплое
        рубиновое дыхание — как у настоящей звезды в космосе.
    -->
    <!-- Слой 0: самое внешнее дыхание ореола, круг r=9.5, #1AEF4444. -->
    <path
        android:fillColor="#1AEF4444"
        android:pathData="M12,2.5 C17.25,2.5 21.5,6.75 21.5,12 C21.5,17.25 17.25,21.5 12,21.5 C6.75,21.5 2.5,17.25 2.5,12 C2.5,6.75 6.75,2.5 12,2.5 Z" />
    <!-- Слой 1: плотное ядро свечения, круг r=6.5, #2EE11D48. -->
    <path
        android:fillColor="#2EE11D48"
        android:pathData="M12,5.5 C15.59,5.5 18.5,8.41 18.5,12 C18.5,15.59 15.59,18.5 12,18.5 C8.41,18.5 5.5,15.59 5.5,12 C5.5,8.41 8.41,5.5 12,5.5 Z" />
    <!-- Орбитальное эллиптическое кольцо (rx=9, ry=3.5), наклон -28°. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-28">
        <path
            android:fillColor="#00000000"
            android:pathData="M3,12 C3,10.07 7.03,8.5 12,8.5 C16.97,8.5 21,10.07 21,12 C21,13.93 16.97,15.5 12,15.5 C7.03,15.5 3,13.93 3,12 Z"
            android:strokeColor="#B3FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="1.1" />
    </group>
    <!-- Четырёхлучевая звезда: мягкая заливка + чёткий контур. -->
    <path
        android:fillColor="#38FFFFFF"
        android:pathData="M12,2.5 C12,7.2 14.2,9.8 20.5,12 C14.2,14.2 12,16.8 12,21.5 C12,16.8 9.8,14.2 3.5,12 C9.8,9.8 12,7.2 12,2.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="1.2" />
    <!-- Яркое ядро в центре звезды (r=2). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10 C13.1,10 14,10.9 14,12 C14,13.1 13.1,14 12,14 C10.9,14 10,13.1 10,12 C10,10.9 10.9,10 12,10 Z" />
</vector>
