<?xml version="1.0" encoding="utf-8"?>
<!--
    Стеклянная пилюля быстрых инструментов и пилюля модели в виджете Марса.

    Одна форма на два места — бейдж модели в шапке и чипы нижней полосы («Локально»,
    «Задачи», «Память», «Музыка»): это один и тот же элемент языка — тихая стеклянная
    поверхность на обсидиане, а не цветная кнопка. Пёстрые заливки на домашнем экране
    выглядят как рекламный баннер, поэтому единственный цвет здесь — 8% белого стекла
    и грань @color/mars_glass_stroke (20% белого), как у капсулы ввода.

    Радиус 14dp при высоте 28dp даёт ровную «таблетку»: скругление ровно в половину
    высоты, без сплюснутых углов на больших экранах и без «мыла» при плотности xxhdpi.

    Ripple-обёртка обязательна: это RemoteViews, у него нет setOnTouchListener,
    единственная обратная связь на тап — фон-ripple, который система отрисует сама.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mars_glass_stroke">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/mars_glass_stroke" />
        </shape>
    </item>

</ripple>
