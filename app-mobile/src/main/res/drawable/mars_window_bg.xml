<?xml version="1.0" encoding="utf-8"?>
<!-- Фон окна: фирменный рендер Марса поверх обсидианового #07080B.

     Три слоя, и каждый отвечает за свой дефект:

     1. Базовый цвет. Пока битмап не декодирован (первый кадр окна), виден он,
        а не чёрный прямоугольник SurfaceFlinger.
     2. Сам рендер, gravity="fill" вместо "center". Картинка — 1080x2400
        (20:9), а экраны разные: POCO F5 — 20:9, старые аппараты 18:9,
        складные и планшеты ещё шире. При "center" кадр не масштабировался
        вовсе: на 18:9 сверху и снизу оставались полосы чистого цвета, на
        планшете — широкие поля. "fill" растягивает кадр на окно: искажение
        аспекта на реальных устройствах ≤ 4%, а на звёздном поле и диске
        планеты это не различимо — зато полос нет ни на одном.
     3. Вуаль-градиент: сверху прозрачная, снизу плотная. Текст и композер
        живут в нижней половине экрана, и без вуали яркий лимб планеты
        просвечивал под подписями. Плотность — из палитры
        (mars_bg_scrim_top/bottom), а не из литерала, и переключается системной
        темой (values-night/colors.xml).

     Приглушение до alpha 0.40 осталось: карточки непрозрачны, но заголовки
     секций лежат прямо на картинке, и на полной яркости рендер их съедал.
     Файл тот же, что у заставки (@drawable/mars_bg): раньше здесь лежала
     байт-в-байт копия mars_splash_bg.jpg, и APK вёз кадр дважды. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mars_background" />
    <item android:alpha="0.40">
        <bitmap
            android:src="@drawable/mars_bg"
            android:gravity="fill"
            android:filter="true" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/mars_bg_scrim_top"
                android:endColor="@color/mars_bg_scrim_bottom" />
        </shape>
    </item>
</layer-list>
