<?xml version="1.0" encoding="utf-8"?>
<!-- Фон окна: фирменный кадр Марса поверх обсидианового #07080B.

     Четыре слоя, и каждый отвечает за свой дефект:

     1. Базовый цвет. Пока битмап не декодирован (первый кадр окна), виден он,
        а не чёрный прямоугольник SurfaceFlinger.
     2. Сам кадр, alpha 0.62. Прежние 0.40 оказались провалом: при 40% диск
        планеты после вуали читался как «смутное тёмное пятно», деталей
        поверхности не оставалось вовсе (замер по кадру: ярчайший пиксель
        200/255 → 80/255, средний тон диска ~45/255). 0.62 даёт узнаваемый
        Марс и всё ещё оставляет текст читаемым: на самом ярком пикселе
        лимба mars_text держит 10.9:1, mars_muted — 4.4:1 при норме 4.5.
     3. Вуаль-градиент: сверху почти прозрачная, снизу плотная. Текст,
        композер и карточки живут в нижней половине, а нижняя половина кадра
        — это уже тень планеты, поэтому плотный низ не «съедает» диск, а
        доводит контраст подписей. Плотность — из палитры
        (mars_bg_scrim_top/bottom), а не из литерала, и переключается
        системной темой (values-night/colors.xml).
     4. Виньетка по краям: гасит светлые углы кадра на широких экранах, где
        gravity="fill" растягивает картинку по горизонтали.

     gravity="fill", а не "center": кадр 1080x2400 (20:9), а экраны разные.
     При "center" на 18:9 сверху и снизу оставались полосы чистого цвета, на
     планшете — широкие поля. "fill" растягивает кадр: искажение аспекта на
     реальных телефонах ≤ 4% (POCO F5 — 0%), и на диске это не различимо.

     Кадр — тот же, что у заставки (@drawable/mars_bg): раньше здесь лежала
     байт-в-байт копия mars_splash_bg.jpg, и APK вёз картинку дважды.
     Яркость различают атрибуты слоя, а не второй файл. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mars_background" />
    <item android:alpha="0.62">
        <bitmap
            android:src="@drawable/mars_bg"
            android:gravity="fill"
            android:filter="true" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/mars_bg_scrim_top"
                android:endColor="@color/mars_bg_scrim_bottom" />
        </shape>
    </item>
    <!-- Виньетка: радиальный градиент из прозрачного центра к обсидиану по
         краям. Ровный scrim по горизонтали здесь не годится — он погасил бы
         и центр диска, то есть сам акцент кадра. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="78%p"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="@color/mars_bg_vignette_inner"
                android:endColor="@color/mars_bg_vignette_outer" />
        </shape>
    </item>
</layer-list>
