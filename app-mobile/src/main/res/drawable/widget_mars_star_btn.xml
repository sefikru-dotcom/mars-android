<?xml version="1.0" encoding="utf-8"?>
<!--
    Тёмный рубиновый ореол кнопки-звезды в виджете (новый чат).

    Паритет с кнопкой отправки композера (MarsTheme.SEND_HALO_BG #D81A1018 и
    кольцо SEND_HALO_BORDER #73EF4444): звезда живёт в тёмном космосе, а не на
    залитом ярко-красном круге. Ripple — рубиновый, чтобы тап ощущался «звёздным».
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40EF4444">

    <item>
        <shape android:shape="oval">
            <solid android:color="#D81A1018" />
            <stroke
                android:width="1dp"
                android:color="#73EF4444" />
        </shape>
    </item>

</ripple>
