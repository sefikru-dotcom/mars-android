<?xml version="1.0" encoding="utf-8"?>
<!-- Фон заставки: фирменный кадр Марса на полной яркости.

     Отличие от mars_window_bg (alpha 0.62) намеренное: там кадр — подложка
     под читаемый текст и карточки, здесь он и есть бренд-экран, поэтому
     приглушать его нечем и незачем. Базовый цвет — тот же обсидиан, что и у
     остального клиента, чтобы стык с первым кадром ChatActivity не мигал.

     gravity="fill" — то же решение, что в mars_window_bg: кадр 1080x2400
     обязан покрыть окно любой пропорции. При "center" на 19.5:9 и на планшете
     по краям оставались полосы обсидиана, и «бренд-экран» выглядел
     приклеенной карточкой, а не фоном.

     Вуали здесь нет: заставка — единственный экран, где кадр показывает себя
     целиком, и затемнять его значило бы спорить с самой идеей бренд-кадра.
     Контент заставки (слово «МАРС» и пульсирующий ореол) лежит ПОВЕРХ диска
     планеты — см. SplashActivity: отступы колонки привязаны к геометрии кадра.

     Ссылка на @drawable/mars_bg, а НЕ на отдельный mars_splash_bg: это был
     байт-в-байт дубль того же рендера, и APK вёз одну картинку дважды.
     Яркость различают атрибуты слоя, а не второй файл. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mars_background" />
    <item>
        <bitmap
            android:src="@drawable/mars_bg"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
