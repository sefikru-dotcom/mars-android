<?xml version="1.0" encoding="utf-8"?>
<!-- Уход заставки под появляющийся целевой экран.

     Гасим НЕ в прозрачность «в никуда»: оба экрана рисуют один и тот же
     брендовый фон (@drawable/mars_bg), поэтому перекрёстное затухание
     заставки под проявление чата выглядит как непрерывный кадр, а не как
     провал в чёрное между двумя окнами. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:fromAlpha="1.0"
    android:toAlpha="0.0"
    android:interpolator="@android:interpolator/decelerate_cubic" />
