<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MarsMusicPlayer (Media3/ExoPlayer): PARTIAL_WAKE_LOCK на время загрузки/рендеринга
         сетевого аудиопотока (setWakeMode gated by permission — app-tv паттерн). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Мониторинг сети (NetworkConnectivityObserver): детекция Available/Losing/Lost. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MarsMusicService: фоновое воспроизведение + медиа-нотификация в шторке -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".MarsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/AppTheme"
        android:label="Марс"
        android:icon="@drawable/ic_mars">
        <activity android:name=".ChatActivity" />
        <!-- Уровень списка диалогов — корень раздела CHAT двухуровневого навигатора (волна 2). -->
        <activity android:name=".ChatSessionsActivity" />
        <activity android:name=".MusicActivity" />
        <service
            android:name=".service.MarsMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- FCM push (волна 4): приём сообщений и ротация токена; регистрация
             токена на сервере — PushTokenSync (POST /api/push/fcm/register). -->
        <service
            android:name=".service.MarsPushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name=".ProjectsActivity" />
        <activity android:name=".MemoryActivity" />
        <activity android:name=".SkillsActivity" />
        <activity android:name=".TodosActivity" />
        <activity android:name=".CronActivity" />
        <activity android:name=".SettingsActivity" />
        <!-- Read-only доска канбана (GET /api/kanban/*) и мониторинг; запуск из левого бара (AppNavIntents.sectionIntent). -->
        <activity android:name=".KanbanActivity" />
        <activity android:name=".InsightsActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
