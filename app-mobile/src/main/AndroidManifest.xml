<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MarsMusicPlayer (Media3/ExoPlayer): PARTIAL_WAKE_LOCK на время загрузки/рендеринга
         сетевого аудиопотока (setWakeMode gated by permission — app-tv паттерн). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Мониторинг сети (NetworkConnectivityObserver): детекция Available/Losing/Lost. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MarsMusicService: фоновое воспроизведение + медиа-нотификация в шторке -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Голосовой сервис (разговор при заблокированном экране). Android 14 требует
         отдельное разрешение на тип «микрофон»: без него startForeground с
         foregroundServiceType="microphone" бросает SecurityException и процесс
         убивается. Разрешение normal — в рантайме не спрашивается. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Локальный чат (раздел «Локально»): инструменты телефона, выполняемые моделью
         напрямую, без сервера Марса. Каждое разрешение спрашивается в рантайме в момент
         первого действия и НЕ запрашивается при старте приложения: запрос без действия
         человека выглядит как слежка. Здесь только объявление, иначе система молча
         откажет в запросе.
         READ_CONTACTS — find_contact; READ/WRITE_CALENDAR — list_events/create_event;
         будильник и таймер идут через AlarmClock-Intent и разрешений не требуют. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- SET_ALARM: начиная с Android 12/13 приложение не может отправить
         AlarmClock.ACTION_SET_ALARM без этого разрешения — система даёт
         Permission Denial, и будильник молча не ставится (проверено на POCO F5,
         Android 15: «Permission Denial: starting Intent act=SET_ALARM»).
         Разрешение обычное (normal), без запроса в рантайме. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Android 11+: чтобы найти обработчик AlarmClock/Calendar-Intent, нужен <queries>
         (пакетный менеджер иначе возвращает пустоту и инструмент ложно сообщает
         «нет приложения часов»). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>
    <application
        android:name=".MarsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/AppTheme"
        android:label="Марс"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- adjustResize: клавиатура ужимает окно, а не сдвигает контент панорамированием —
             композер остаётся над IME, поле ввода не «прыгает» под клавиатуру. -->
        <activity
            android:name=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- Уровень списка диалогов — корень раздела CHAT двухуровневого навигатора (волна 2). -->
        <activity android:name=".ChatSessionsActivity" />
        <activity android:name=".MusicActivity" />
        <service
            android:name=".service.MarsMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Голосовой разговор при заблокированном экране. foregroundServiceType="microphone"
             обязателен: без него на Android 14+ startForeground с типом microphone бросает
             SecurityException и процесс убивается. exported=false — старт только из своего
             процесса (кнопкой на активном экране; из фона Android 14+ запрещает). -->
        <service
            android:name=".service.MarsVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- FCM push: приём сообщений и ротация токена (пакет fcm). Сервис принимает
             data-only сообщения Марса (видимые — канал/иконка/цвет из палитры,
             тихие — синхронизация без уведомления) и регистрирует токен на
             сервере через PushTokenSync (POST /api/push/fcm/register).
             default_notification_* нужны для notification-payload, который система
             рисует САМА при убитом процессе: без channel_id Android 8+ отбрасывает
             такое уведомление, без icon/color — рисует чужой серый значок. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_mars" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mars_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mars_push_chat" />
        <service
            android:name=".fcm.MarsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name=".ProjectsActivity" />
        <activity android:name=".MemoryActivity" />
        <activity android:name=".SkillsActivity" />
        <activity android:name=".TodosActivity" />
        <activity android:name=".CronActivity" />
        <activity android:name=".SettingsActivity" />
        <!-- Каталог рабочих пространств (GET /api/workspaces) и выбор контекста
             следующих сообщений: раздел левого бара AppDestination.SPACES. -->
        <activity android:name=".SpacesActivity" />
        <!-- Локальный чат: диалоги идут напрямую к провайдеру (OpenAI-совместимый API),
             без сервера Марса. Список диалогов — корень раздела LOCAL, диалог — уровень
             внутри него (паритет двухуровневого стека CHAT). adjustResize — чтобы
             композер не уезжал под клавиатуру. -->
        <activity android:name=".LocalSessionsActivity" />
        <activity
            android:name=".LocalChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LocalProviderSettingsActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- Память модели: профиль владельца и запомненные факты (вход из локального чата). -->
        <activity
            android:name=".LocalMemoryActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- Read-only список профилей сервера (GET /api/profiles): вход из Настройки. -->
        <activity android:name=".ProfilesActivity" />
        <!-- Read-only доска канбана (GET /api/kanban/*) и мониторинг; запуск из левого бара (AppNavIntents.sectionIntent). -->
        <activity android:name=".KanbanActivity" />
        <activity android:name=".InsightsActivity" />
        <!-- Экспорт диалога в Markdown: файл лежит в cacheDir/session-exports и
             отдаётся наружу через FileProvider (content://), т.к. file:// URI
             запрещён на targetSdk ≥ 24 (FileUriExposedException). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sessionexports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Точка входа — заставка, а не MainActivity: при сохранённом credential
             MainActivity не рисует ни кадра (сразу openChat + finish), поэтому
             бренд-экран должен быть отдельным шагом ДО неё. exported=true обязателен
             для LAUNCHER-активности, иначе система не покажет иконку в лончере. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Логин/маршрутизация после заставки. exported остаётся true: на этот экран
             ведут deep link и повторная авторизация из ChatActivity/Settings. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <!-- Виджет домашнего экрана «Музыка Марса» (4x2): обложка, название,
             исполнитель, prev/play-pause/next. Своего плеера и сервиса у виджета
             нет — кнопки шлют те же ACTION_*, что и шторка, в MarsMusicService,
             а состояние приходит из процессного MarsMusicPlayer. exported=false:
             AppWidget broadcast приходит от системного лаунчера тому получателю,
             которого назвал сам launcher по метаданным, поэтому наружу receiver
             не открыт.
             initialKeyguardLayout не задан намеренно: на экране блокировки виджет
             уже рисуется MediaSession'ом сервиса, и второй набор контролов там
             только мешает. -->
        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="false"
            android:label="@string/music_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>
    </application>
</manifest>
