<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MarsMusicPlayer (Media3/ExoPlayer): PARTIAL_WAKE_LOCK на время загрузки/рендеринга
         сетевого аудиопотока (setWakeMode gated by permission — app-tv паттерн). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Мониторинг сети (NetworkConnectivityObserver): детекция Available/Losing/Lost. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MarsMusicService: фоновое воспроизведение + медиа-нотификация в шторке -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".MarsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/AppTheme"
        android:label="Марс"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity android:name=".ChatActivity" />
        <!-- Уровень списка диалогов — корень раздела CHAT двухуровневого навигатора (волна 2). -->
        <activity android:name=".ChatSessionsActivity" />
        <activity android:name=".MusicActivity" />
        <service
            android:name=".service.MarsMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- FCM push: приём сообщений и ротация токена (пакет fcm). Сервис принимает
             data-only сообщения Марса (видимые — канал/иконка/цвет из палитры,
             тихие — синхронизация без уведомления) и регистрирует токен на
             сервере через PushTokenSync (POST /api/push/fcm/register).
             default_notification_* нужны для notification-payload, который система
             рисует САМА при убитом процессе: без channel_id Android 8+ отбрасывает
             такое уведомление, без icon/color — рисует чужой серый значок. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_mars" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mars_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mars_push_chat" />
        <service
            android:name=".fcm.MarsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name=".ProjectsActivity" />
        <activity android:name=".MemoryActivity" />
        <activity android:name=".SkillsActivity" />
        <activity android:name=".TodosActivity" />
        <activity android:name=".CronActivity" />
        <activity android:name=".SettingsActivity" />
        <!-- Read-only список профилей сервера (GET /api/profiles): вход из Настройки. -->
        <activity android:name=".ProfilesActivity" />
        <!-- Read-only доска канбана (GET /api/kanban/*) и мониторинг; запуск из левого бара (AppNavIntents.sectionIntent). -->
        <activity android:name=".KanbanActivity" />
        <activity android:name=".InsightsActivity" />
        <!-- Экспорт диалога в Markdown: файл лежит в cacheDir/session-exports и
             отдаётся наружу через FileProvider (content://), т.к. file:// URI
             запрещён на targetSdk ≥ 24 (FileUriExposedException). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sessionexports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Точка входа — заставка, а не MainActivity: при сохранённом credential
             MainActivity не рисует ни кадра (сразу openChat + finish), поэтому
             бренд-экран должен быть отдельным шагом ДО неё. exported=true обязателен
             для LAUNCHER-активности, иначе система не покажет иконку в лончере. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Логин/маршрутизация после заставки. exported остаётся true: на этот экран
             ведут deep link и повторная авторизация из ChatActivity/Settings. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />
    </application>
</manifest>
