<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:gravity="center" android:padding="48dp" android:background="@color/mars_background" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Подключение к Марсу" android:textColor="@color/mars_text" android:textSize="32sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/pairingCode" android:text="------" android:textColor="@color/mars_accent" android:textSize="72sp" android:textStyle="bold" android:letterSpacing="0.18" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/pairingTimer" android:textColor="@color/mars_muted" android:textSize="22sp" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/pairingStatus" android:textColor="@color/mars_text" android:textSize="24sp" android:gravity="center" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/retryButton" android:text="Повторить" android:textSize="20sp" android:layout_marginTop="28dp" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
