<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Скиллы» (TV, read-only): каталог скиллов сервера
     (GET /api/skills) + fail-soft статистика использования
     (GET /api/skills/usage). Состояния: loading / error / data. Пустой каталог —
     валидное состояние («На сервере пока нет скиллов», TvSkillsPolicy.EMPTY_LIST),
     не ошибка. Чипы категорий и кнопка сортировки — D-pad; statusView —
     live region (polite). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="40dp"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/sortButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Скиллы"
            android:textColor="@color/mars_text_strong"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:text="Загрузка каталога…"
            android:textColor="@color/mars_muted"
            android:textSize="18sp"
            android:gravity="end"
            android:maxWidth="560dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/sortButton"
            android:text="По имени"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:nextFocusRight="@id/refreshButton"
            android:layout_marginStart="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusLeft="@id/sortButton"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/noticeText"
        android:text="Каталог только для чтения"
        android:textColor="@color/mars_muted"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Чипы категорий: «Все» + категории каталога (строятся программно) -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/chipsRow"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Состояние 1: первичная загрузка (до первого успешного ответа) -->
        <LinearLayout
            android:id="@+id/loadingGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:indeterminateTint="@color/mars_accent"
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:text="Загрузка каталога…"
                android:textColor="@color/mars_muted"
                android:textSize="20sp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 2: явная ошибка (нет данных и кэш непригоден) -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:src="@drawable/ic_status_dot_error"
                android:contentDescription="@null"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/errorText"
                android:textColor="@color/mars_status_error"
                android:textSize="24sp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/retryButton"
                android:text="Повторить"
                android:textSize="20sp"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:layout_marginTop="22dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 3: данные (LIVE или CACHED — различие в плашке statusView) -->
        <ScrollView
            android:id="@+id/dataScroll"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/emptyText"
                    android:visibility="gone"
                    android:textColor="@color/mars_muted"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/skillsContainer"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
