<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Скиллы» (TV, read-only): каталог скиллов сервера
     (GET /api/skills) + fail-soft статистика использования
     (GET /api/skills/usage). Состояния: loading / error / data. Пустой каталог —
     валидное состояние («На сервере пока нет скиллов», TvSkillsPolicy.EMPTY_LIST),
     не ошибка. Чипы категорий и кнопка сортировки — D-pad; statusView —
     live region (polite). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusRight="@id/sortButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:minWidth="@dimen/tv_title_min_w"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Скиллы"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Headline"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Загрузка каталога…"
            android:textColor="@color/mars_muted"
            android:textAppearance="@style/AppText.Body"
            android:gravity="end"
            android:maxWidth="560dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/sortButton"
            android:text="По имени"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:nextFocusRight="@id/refreshButton"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusLeft="@id/sortButton"
            android:layout_marginStart="@dimen/tv_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/noticeText"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Каталог только для чтения"
        android:textColor="@color/mars_muted"
        android:textAppearance="@style/AppText.Label"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Чипы категорий: «Все» + категории каталога (строятся программно) -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_gap_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/chipsRow"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_marginTop="@dimen/tv_gap_s"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Состояние 1: первичная загрузка (до первого успешного ответа) -->
        <LinearLayout
            android:id="@+id/loadingGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:indeterminateTint="@color/mars_accent"
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Загрузка каталога…"
                android:textColor="@color/mars_muted"
                android:textAppearance="@style/AppText.Body"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 2: явная ошибка (нет данных и кэш непригоден) -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:src="@drawable/ic_status_dot_error"
                android:contentDescription="@null"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/errorText"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/mars_status_error"
                android:textAppearance="@style/AppText.Title"
                android:gravity="center"
                android:maxWidth="720dp"
                android:layout_marginTop="@dimen/tv_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/retryButton"
                android:text="Повторить"
                android:textAppearance="@style/AppText.Body"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="@dimen/tv_gap_s"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_xl"
                android:paddingEnd="@dimen/tv_gap_xl"
                android:paddingTop="@dimen/tv_gap_m"
                android:paddingBottom="@dimen/tv_gap_m"
                android:focusable="true"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 3: данные (LIVE или CACHED — различие в плашке statusView) -->
        <ScrollView
            android:id="@+id/dataScroll"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/tv_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/emptyText"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:textColor="@color/mars_muted"
                    android:textAppearance="@style/AppText.Body"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/tv_gap_xl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/skillsContainer"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
