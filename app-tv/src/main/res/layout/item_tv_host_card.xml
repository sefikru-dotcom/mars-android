<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка хоста: статус выводится из факта получения данных (не заглушка). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_focus_card"
    android:padding="@dimen/tv_card_pad"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/hostTitle"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Хост Aeza Mars"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Title"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/hostStatusDot"
            android:src="@drawable/ic_status_dot"
            android:contentDescription="@null"
            android:layout_width="12dp"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/hostStatusLabel"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/mars_status_online"
            android:textAppearance="@style/AppText.Body"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/hostMetrics"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/mars_muted_on_glass"
        android:textAppearance="@style/AppText.Body"
        android:lineSpacingExtra="@dimen/tv_gap_xs"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
