<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Память» (TV, read-only): секции GET /api/memory — табы
     Память/Профиль/Душа/Контекст. Состояния: loading / error / data.
     Пустая секция — валидное состояние («Секция MEMORY.md пуста»,
     TvMemoryPolicy.emptyLine), не ошибка. statusView — live region (polite).
     dataScroll фокусируемый: длинный текст листается D-pad-ом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusRight="@id/refreshButton"
            android:nextFocusDown="@id/tabMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:minWidth="@dimen/tv_title_min_w"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Память"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Headline"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Загрузка памяти…"
            android:textColor="@color/mars_muted"
            android:textAppearance="@style/AppText.Body"
            android:gravity="end"
            android:maxWidth="560dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:nextFocusDown="@id/tabProject"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/noticeText"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Раздел только для чтения"
        android:textColor="@color/mars_muted"
        android:textAppearance="@style/AppText.Label"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Табы секций памяти (D-pad left/right, чип-селектор bg_focus_chip) -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/tabMemory"
            android:text="Память"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/backButton"
            android:nextFocusRight="@id/tabUser"
            android:nextFocusDown="@id/dataScroll"
            android:layout_marginEnd="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tabUser"
            android:text="Профиль"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/backButton"
            android:nextFocusLeft="@id/tabMemory"
            android:nextFocusRight="@id/tabSoul"
            android:nextFocusDown="@id/dataScroll"
            android:layout_marginEnd="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tabSoul"
            android:text="Душа"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/backButton"
            android:nextFocusLeft="@id/tabUser"
            android:nextFocusRight="@id/tabProject"
            android:nextFocusDown="@id/dataScroll"
            android:layout_marginEnd="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tabProject"
            android:text="Контекст"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/refreshButton"
            android:nextFocusLeft="@id/tabSoul"
            android:nextFocusDown="@id/dataScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Подпись активной секции: имя файла + «Обновлено N назад» -->
    <TextView
        android:id="@+id/metaText"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/mars_muted"
        android:textAppearance="@style/AppText.Label"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_marginTop="@dimen/tv_gap_s"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Состояние 1: первичная загрузка (до первого успешного ответа) -->
        <LinearLayout
            android:id="@+id/loadingGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:indeterminateTint="@color/mars_accent"
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Загрузка памяти…"
                android:textColor="@color/mars_muted"
                android:textAppearance="@style/AppText.Body"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 2: явная ошибка (нет данных и кэш непригоден) -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:src="@drawable/ic_status_dot_error"
                android:contentDescription="@null"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/errorText"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/mars_status_error"
                android:textAppearance="@style/AppText.Title"
                android:gravity="center"
                android:maxWidth="720dp"
                android:layout_marginTop="@dimen/tv_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/retryButton"
                android:text="Повторить"
                android:textAppearance="@style/AppText.Body"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="@dimen/tv_gap_s"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_xl"
                android:paddingEnd="@dimen/tv_gap_xl"
                android:paddingTop="@dimen/tv_gap_m"
                android:paddingBottom="@dimen/tv_gap_m"
                android:focusable="true"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние 3: данные (LIVE или CACHED — различие в плашке statusView) -->
        <ScrollView
            android:id="@+id/dataScroll"
            android:visibility="gone"
            android:scrollbars="none"
            android:focusable="true"
            android:background="@drawable/bg_focus_card"
            android:padding="@dimen/tv_card_pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Документ-тело секции: прокручивается целиком, maxLines здесь
                 обрезал бы содержимое памяти — исключение из бюджета строк. -->
            <TextView
                android:id="@+id/bodyText"
                android:textColor="@color/mars_text_em"
                android:textAppearance="@style/AppText.Body"
                android:lineSpacingExtra="@dimen/tv_gap_s"
                android:fontFamily="monospace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
