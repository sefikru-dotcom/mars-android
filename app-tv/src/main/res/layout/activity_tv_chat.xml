<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="36dp" android:background="@color/mars_background" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Чат с Марсом" android:textColor="@color/mars_text" android:textSize="32sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:text="● онлайн" android:textColor="#7EE787" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/backButton" android:text="Назад" android:focusable="true" android:layout_marginStart="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ScrollView android:id="@+id/messageScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/messages" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/messageInput" android:hint="Сообщение…" android:textColor="@color/mars_text" android:textColorHint="@color/mars_muted" android:textSize="22sp" android:singleLine="true" android:imeOptions="actionSend" android:nextFocusRight="@id/sendButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/sendButton" android:text="Отправить" android:textSize="20sp" android:focusable="true" android:nextFocusLeft="@id/messageInput" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
