<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout: the chat screen plus the «Диалоги» browser overlay on top of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/chatRoot"
        android:orientation="vertical"
        android:padding="36dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_mars"
                android:contentDescription="@null"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp" />

            <TextView
                android:text="Чат с Марсом"
                android:textColor="@color/mars_text_strong"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <!-- Режим показа хода (паритет с мобильным ActivityDisplayMode): клик — цикл
                 «Всё» -> «Окно» -> «Тишина», выбор сохраняется между запусками. -->
            <Button
                android:id="@+id/displayModeButton"
                android:focusable="true"
                android:layout_marginStart="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_settings"
                android:drawableTint="@color/icon_focus_tint"
                android:text="Режим: Окно"
                android:textColor="@color/mars_text"
                android:textSize="20sp"
                android:drawablePadding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/sessionsButton"
                android:focusable="true"
                android:layout_marginStart="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_chat"
                android:drawableTint="@color/icon_focus_tint"
                android:text="Диалоги"
                android:textColor="@color/mars_text"
                android:textSize="20sp"
                android:drawablePadding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/newChatButton"
                android:focusable="true"
                android:layout_marginStart="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_new_chat"
                android:drawableTint="@color/icon_focus_tint"
                android:text="Новый чат"
                android:textColor="@color/mars_text"
                android:textSize="20sp"
                android:drawablePadding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/backButton"
                android:focusable="true"
                android:layout_marginStart="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawableTint="@color/icon_focus_tint"
                android:text="Назад"
                android:textColor="@color/mars_text"
                android:textSize="20sp"
                android:drawablePadding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Mini player: mirrors the global TvMusicPlayer transport while a track is bound;
             rules (visibility/caption/toggle label) live in TvMiniPlayerSpec. Gone when idle. -->
        <LinearLayout
            android:id="@+id/miniPlayerRow"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:layout_marginTop="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_music"
                android:contentDescription="@null"
                app:tint="@color/mars_muted"
                android:layout_marginEnd="12dp"
                android:layout_width="26dp"
                android:layout_height="26dp" />

            <TextView
                android:id="@+id/miniPlayerText"
                android:textColor="@color/mars_text"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/miniPlayerToggle"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="16dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_pause"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="8dp"
                android:text="Пауза"
                android:textColor="@color/mars_text"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Status strip: live reasoning/tool status + context-fill pill (both hidden when unknown) -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/statusText"
                android:textColor="@color/mars_muted"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/contextText"
                android:textColor="@color/mars_status_online"
                android:textSize="16sp"
                android:singleLine="true"
                android:visibility="gone"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Transcript + floating «К последнему» jump control. Auto-scroll is pin-aware
             (TvAutoScrollPolicy): the control appears only while the reader is away from
             the live edge and hides again on the jump/back-to-bottom (focus moves to the
             composer — a disappearing control must never drop the D-pad focus). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/messageScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/messages"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <Button
                android:id="@+id/jumpToBottomButton"
                android:text="К последнему"
                android:textSize="16sp"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_chip"
                android:drawableStart="@drawable/ic_chevron_down"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- Quick chips: canned one-tap turns above the composer (TvQuickChipsPolicy);
             buttons are built programmatically into quickChipsRow. -->
        <HorizontalScrollView
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/quickChipsRow"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/messageInput"
                android:hint="Сообщение…"
                android:textColor="@color/mars_text"
                android:textColorHint="@color/mars_muted"
                android:textSize="22sp"
                android:singleLine="true"
                android:background="@drawable/bg_focus_input"
                android:padding="16dp"
                android:focusable="true"
                android:imeOptions="actionSend"
                android:nextFocusRight="@id/sendButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="64dp" />

            <Button
                android:id="@+id/sendButton"
                android:text="Отправить"
                android:textSize="20sp"
                android:textColor="@color/mars_on_accent"
                android:textStyle="bold"
                android:background="@drawable/bg_focus_accent"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="@color/mars_on_accent"
                android:drawablePadding="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:focusable="true"
                android:nextFocusLeft="@id/messageInput"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="64dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Session browser dialog («Диалоги»): full-screen scrim + centered focusable panel.
         Rows are rendered programmatically into sessionList; every decision (which rows,
         initial focus, D-pad stepping) lives in TvSessionBrowserPolicy. -->
    <FrameLayout
        android:id="@+id/sessionsOverlay"
        android:background="@color/mars_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_session_panel"
            android:padding="28dp"
            android:layout_gravity="center"
            android:layout_marginStart="110dp"
            android:layout_marginEnd="110dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:text="Диалоги"
                android:textColor="@color/mars_text_strong"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/sessionsStatus"
                android:textColor="@color/mars_muted"
                android:textSize="17sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/sessionScroll"
                android:scrollbars="none"
                android:fillViewport="true"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/sessionList"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <Button
                android:id="@+id/closeSessionsButton"
                android:text="Закрыть"
                android:textSize="18sp"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
