<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout: the chat screen plus the «Диалоги» browser overlay on top of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/chatRoot"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_screen_pad_h"
        android:paddingEnd="@dimen/tv_screen_pad_h"
        android:paddingTop="@dimen/tv_screen_pad_top"
        android:paddingBottom="@dimen/tv_screen_pad_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Шапка: бюджет 912dp = логотип 40 + gap 12 + заголовок (min 180, weight 1)
             + «Режим» текстом + три иконки 40dp. Вторичные действия — ИКОНКИ:
             четыре текстовые кнопки занимали 732dp, заголовку оставалось 38dp,
             и он схлопывался в вертикальную колонку по одной букве. -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_header_h">

            <ImageView
                android:src="@drawable/ic_mars"
                android:contentDescription="@null"
                android:layout_width="@dimen/tv_btn_icon_h"
                android:layout_height="@dimen/tv_btn_icon_h"
                android:layout_marginEnd="@dimen/tv_gap_m" />

            <TextView
                android:id="@+id/chatTitle"
                android:text="Чат с Марсом"
                android:textAppearance="@style/AppText.Headline"
                android:minWidth="@dimen/tv_title_min_w"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <!-- Режим показа хода (паритет с мобильным ActivityDisplayMode): клик — цикл
                 «Всё» -> «Окно» -> «Тишина», выбор сохраняется между запусками. -->
            <Button
                android:id="@+id/displayModeButton"
                android:focusable="true"
                android:layout_marginStart="@dimen/tv_gap_m"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_btn_pad_h"
                android:paddingEnd="@dimen/tv_btn_pad_h"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_settings"
                android:drawableTint="@color/icon_focus_tint"
                android:text="Режим: Окно"
                android:textAppearance="@style/AppText.Button"
                android:drawablePadding="@dimen/tv_btn_icon_gap"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_btn_h" />

            <Button
                android:id="@+id/sessionsButton"
                android:focusable="true"
                android:layout_marginStart="@dimen/tv_btn_gap"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_s"
                android:paddingEnd="@dimen/tv_gap_s"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_chat"
                android:drawableTint="@color/icon_focus_tint"
                android:contentDescription="Диалоги"
                android:layout_width="@dimen/tv_btn_icon_h"
                android:layout_height="@dimen/tv_btn_icon_h" />

            <Button
                android:id="@+id/newChatButton"
                android:focusable="true"
                android:layout_marginStart="@dimen/tv_btn_gap"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_s"
                android:paddingEnd="@dimen/tv_gap_s"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_new_chat"
                android:drawableTint="@color/icon_focus_tint"
                android:contentDescription="Новый чат"
                android:layout_width="@dimen/tv_btn_icon_h"
                android:layout_height="@dimen/tv_btn_icon_h" />

            <Button
                android:id="@+id/backButton"
                android:focusable="true"
                android:layout_marginStart="@dimen/tv_btn_gap"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_s"
                android:paddingEnd="@dimen/tv_gap_s"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawableTint="@color/icon_focus_tint"
                android:contentDescription="Назад"
                android:layout_width="@dimen/tv_btn_icon_h"
                android:layout_height="@dimen/tv_btn_icon_h" />
        </LinearLayout>

        <!-- Mini player: mirrors the global TvMusicPlayer transport while a track is bound;
             rules (visibility/caption/toggle label) live in TvMiniPlayerSpec. Gone when idle. -->
        <LinearLayout
            android:id="@+id/miniPlayerRow"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:layout_marginTop="@dimen/tv_chat_row_gap"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_music"
                android:contentDescription="@null"
                app:tint="@color/mars_muted"
                android:layout_marginEnd="@dimen/tv_gap_m"
                android:layout_width="@dimen/tv_icon_m"
                android:layout_height="@dimen/tv_icon_m" />

            <TextView
                android:id="@+id/miniPlayerText"
                android:textColor="@color/mars_text"
                android:textAppearance="@style/AppText.Label"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/miniPlayerToggle"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="@dimen/tv_gap_l"
                android:paddingStart="@dimen/tv_gap_l"
                android:paddingEnd="@dimen/tv_gap_l"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_pause"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="@dimen/tv_gap_s"
                android:text="Пауза"
                android:textColor="@color/mars_text"
                android:textAppearance="@style/AppText.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_btn_h" />
        </LinearLayout>

        <!-- Status strip: live reasoning/tool status + context-fill pill (both hidden when unknown) -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/tv_chat_row_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/statusText"
                android:textColor="@color/mars_muted"
                android:textAppearance="@style/AppText.Label"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <!-- Бейдж статуса префилл-контекста (side-кадр `context_status`): крупный
                 читаемый с дистанции чип, цвет и текст — из TvContextStatusPresenter.
                 Гаснет сам по таймеру; D-pad его не фокусирует (не интерактивен). -->
            <TextView
                android:id="@+id/contextStatusBadge"
                android:textColor="@color/mars_status_online"
                android:textStyle="bold"
                android:textAppearance="@style/AppText.Title"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="620dp"
                android:paddingStart="@dimen/tv_gap_l"
                android:paddingEnd="@dimen/tv_gap_l"
                android:paddingTop="@dimen/tv_gap_xs"
                android:paddingBottom="@dimen/tv_gap_xs"
                android:background="@drawable/bg_chip"
                android:focusable="false"
                android:visibility="gone"
                android:layout_marginStart="@dimen/tv_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/contextText"
                android:textColor="@color/mars_status_online"
                android:textAppearance="@style/AppText.Body"
                android:singleLine="true"
                android:visibility="gone"
                android:layout_marginStart="@dimen/tv_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Чип квоты провайдера (A10 parity): видимость, подпись и цвет — из
                 TvQuotaPolicy. Интерактивен ровно тогда, когда повтор осмыслен
                 (ошибка/не прочитано); в остальных состояниях D-pad его пропускает. -->
            <TextView
                android:id="@+id/quotaChip"
                android:textColor="@color/mars_text_em"
                android:textAppearance="@style/AppText.Label"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="420dp"
                android:visibility="gone"
                android:paddingStart="@dimen/tv_gap_m"
                android:paddingEnd="@dimen/tv_gap_m"
                android:paddingTop="@dimen/tv_gap_xs"
                android:paddingBottom="@dimen/tv_gap_xs"
                android:background="@drawable/bg_chip"
                android:layout_marginStart="@dimen/tv_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Доска живых субагентов (SubagentStatusUpdate side-канала): одна строка,
             читаемая с дистанции. Не фокусируется — это состояние, а не действие,
             поэтому порядок обхода D-pad не меняется. Текст и тон считает
             TvSubagentBoardPolicy. -->
        <TextView
            android:id="@+id/subagentBoard"
            android:textColor="@color/mars_status_info"
            android:textAppearance="@style/AppText.Label"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:focusable="false"
            android:visibility="gone"
            android:paddingStart="@dimen/tv_gap_xl"
            android:paddingEnd="@dimen/tv_gap_xl"
            android:paddingTop="@dimen/tv_gap_xs"
            android:paddingBottom="@dimen/tv_gap_xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Transcript + floating «К последнему» jump control. Auto-scroll is pin-aware
             (TvAutoScrollPolicy): the control appears only while the reader is away from
             the live edge and hides again on the jump/back-to-bottom (focus moves to the
             composer — a disappearing control must never drop the D-pad focus). -->
        <!-- Лента: пол высоты tv_chat_transcript_min_h (180dp). Бюджет 540dp: поля 28 +
             шапка 52 + зазор 8 + композер 48 = 136dp хрома, клавиатура 224dp ->
             остаток 180dp (два сообщения вместо одного; без клавиатуры 356dp).
             ВАЖНО: height=0dp + weight=1. minHeight на вертикальном LinearLayout тут
             ставить НЕЛЬЗЯ: при открытой клавиатуре окно сжимается до ~318dp, и пол
             вместе с весом выдавливал шапку с экрана (заголовок и «назад» исчезали).
             Пол 180dp держится арифметикой бюджета (TvChatScaleContractTest), а шапка
             должна остаться видимой всегда.
             Ряд чипсов на время IME скрывается целиком
             (TvChatActivity.attachImeChipCollapse) — иначе лента получала 106dp. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/messageScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/messages"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <Button
                android:id="@+id/jumpToBottomButton"
                android:text="К последнему"
                android:textAppearance="@style/AppText.Button"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_chip"
                android:drawableStart="@drawable/ic_chevron_down"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="@dimen/tv_gap_s"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_l"
                android:paddingEnd="@dimen/tv_gap_l"
                android:paddingTop="@dimen/tv_gap_s"
                android:paddingBottom="@dimen/tv_gap_s"
                android:focusable="true"
                android:visibility="gone"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/tv_gap_l"
                android:layout_marginBottom="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- Quick chips: canned one-tap turns above the composer (TvQuickChipsPolicy);
             buttons are built programmatically into quickChipsRow. -->
        <HorizontalScrollView
            android:id="@+id/quickChipsScroll"
            android:layout_marginTop="@dimen/tv_chat_row_gap"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_chat_chips_h">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Параметры хода (модель, уровень размышлений): левая группа той же D-pad-строки. -->
                <LinearLayout
                    android:id="@+id/turnParamsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="@dimen/tv_gap_xl">
                    <Button
                        android:id="@+id/modelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tv_chat_chips_h"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxWidth="340dp"
                        android:paddingStart="@dimen/tv_gap_l"
                        android:paddingEnd="@dimen/tv_gap_l"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@drawable/bg_focus_card"
                        android:textColor="@color/mars_text"
                        android:textAppearance="@style/AppText.Label"
                        android:textAllCaps="false"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:focusable="true"
                        android:clickable="true"
                        android:text="@string/tv_chip_model"
                        android:contentDescription="@string/tv_chip_model_desc" />
                    <Button
                        android:id="@+id/reasoningButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tv_chat_chips_h"
                        android:layout_marginStart="@dimen/tv_gap_m"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxWidth="300dp"
                        android:paddingStart="@dimen/tv_gap_l"
                        android:paddingEnd="@dimen/tv_gap_l"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@drawable/bg_focus_card"
                        android:textColor="@color/mars_text"
                        android:textAppearance="@style/AppText.Label"
                        android:textAllCaps="false"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:clickable="true"
                        android:visibility="gone"
                        android:contentDescription="@string/tv_chip_reasoning_desc" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/quickChipsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tv_chat_chips_h"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/tv_chat_row_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/messageInput"
                android:hint="Сообщение…"
                android:textColor="@color/mars_text"
                android:textColorHint="@color/mars_muted"
                android:textAppearance="@style/AppText.Body"
                android:singleLine="true"
                android:background="@drawable/bg_focus_input"
                android:paddingStart="@dimen/tv_gap_l"
                android:paddingEnd="@dimen/tv_gap_l"
                android:paddingTop="@dimen/tv_gap_s"
                android:paddingBottom="@dimen/tv_gap_s"
                android:gravity="center_vertical"
                android:focusable="true"
                android:imeOptions="actionSend"
                android:nextFocusRight="@id/sendButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/tv_chat_composer_h" />

            <Button
                android:id="@+id/sendButton"
                android:text="Отправить"
                android:textAppearance="@style/AppText.Button"
                android:textColor="@color/mars_on_accent"
                android:textStyle="bold"
                android:background="@drawable/bg_focus_accent"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="@color/mars_on_accent"
                android:drawablePadding="@dimen/tv_gap_s"
                android:paddingStart="@dimen/tv_gap_xl"
                android:paddingEnd="@dimen/tv_gap_xl"
                android:focusable="true"
                android:nextFocusLeft="@id/messageInput"
                android:layout_marginStart="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_chat_composer_h" />
        </LinearLayout>
    </LinearLayout>

    <!-- Session browser dialog («Диалоги»): full-screen scrim + centered focusable panel.
         Rows are rendered programmatically into sessionList; every decision (which rows,
         initial focus, D-pad stepping) lives in TvSessionBrowserPolicy. -->
    <FrameLayout
        android:id="@+id/sessionsOverlay"
        android:background="@color/mars_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_session_panel"
            android:padding="@dimen/tv_screen_pad_h"
            android:layout_gravity="center"
            android:layout_marginStart="110dp"
            android:layout_marginEnd="110dp"
            android:layout_marginTop="@dimen/tv_screen_pad_h"
            android:layout_marginBottom="@dimen/tv_screen_pad_h"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:text="Диалоги"
                android:textAppearance="@style/AppText.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/sessionsStatus"
                android:textColor="@color/mars_muted"
                android:textAppearance="@style/AppText.Label"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/tv_gap_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/sessionScroll"
                android:scrollbars="none"
                android:fillViewport="true"
                android:layout_marginTop="@dimen/tv_gap_m"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/sessionList"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <Button
                android:id="@+id/closeSessionsButton"
                android:text="Закрыть"
                android:textAppearance="@style/AppText.Button"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_xl"
                android:paddingEnd="@dimen/tv_gap_xl"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:focusable="true"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_btn_h" />
        </LinearLayout>
    </FrameLayout>

    <!-- Пикер параметров хода (модель / уровень размышлений): тот же модальный слой,
         что у браузера диалогов. Строки рендерятся программно в paramsList; решения
         (какие строки, начальный фокус, D-pad-шаг) — в TvTurnParamsPolicy. BACK
         закрывает пикер и возвращает фокус на вызвавший чип. -->
    <FrameLayout
        android:id="@+id/paramsOverlay"
        android:background="@color/mars_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_session_panel"
            android:padding="@dimen/tv_screen_pad_h"
            android:layout_gravity="center"
            android:layout_marginStart="170dp"
            android:layout_marginEnd="170dp"
            android:layout_marginTop="@dimen/tv_screen_pad_h"
            android:layout_marginBottom="@dimen/tv_screen_pad_h"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/paramsTitle"
                android:textColor="@color/mars_text_strong"
                android:textAppearance="@style/AppText.Headline"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/paramsScroll"
                android:scrollbars="none"
                android:fillViewport="true"
                android:layout_marginTop="@dimen/tv_gap_m"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/paramsList"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <Button
                android:id="@+id/closeParamsButton"
                android:text="@string/tv_picker_close"
                android:textAppearance="@style/AppText.Button"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/tv_gap_xl"
                android:paddingEnd="@dimen/tv_gap_xl"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:focusable="true"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/tv_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_btn_h" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
