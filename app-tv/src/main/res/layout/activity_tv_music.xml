<?xml version="1.0" encoding="utf-8"?>
<!-- TV music screen (P1): Dark Obsidian + Ruby, D-pad focusable, theme colors only, no emojis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@+id/backButton"
            android:nextFocusRight="@+id/repeatButton"
            android:nextFocusUp="@+id/backButton"
            android:nextFocusDown="@+id/searchInput"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />

        <ImageView
            android:src="@drawable/ic_music"
            android:contentDescription="@null"
            android:layout_marginStart="28dp"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:text="Музыка"
            android:textColor="@color/mars_text_strong"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Обложка текущего трека (живой /music/api/thumb): видима только когда транспорт
             держит трек и серверный thumbnail зарезолвился; грузит TvImageLoader. -->
        <ImageView
            android:id="@+id/nowArt"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginStart="20dp"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/nowText"
            android:textColor="@color/mars_muted"
            android:textSize="18sp"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/repeatButton"
            android:text="Повтор: выкл"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@+id/backButton"
            android:nextFocusRight="@+id/lyricsButton"
            android:nextFocusUp="@+id/repeatButton"
            android:nextFocusDown="@+id/searchInput"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />

        <!-- Текст песни текущего трека: виден вместе с транспортной парой (нет трека — нет текста). -->
        <Button
            android:id="@+id/lyricsButton"
            android:text="Текст песни"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusLeft="@+id/repeatButton"
            android:nextFocusRight="@+id/playPauseButton"
            android:nextFocusUp="@+id/backButton"
            android:nextFocusDown="@+id/searchInput"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />

        <Button
            android:id="@+id/playPauseButton"
            android:text="Играть"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusLeft="@+id/lyricsButton"
            android:nextFocusRight="@+id/stopButton"
            android:nextFocusUp="@+id/backButton"
            android:nextFocusDown="@+id/searchInput"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />
        <Button
            android:id="@+id/stopButton"
            android:text="Остановить"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusLeft="@+id/playPauseButton"
            android:nextFocusRight="@+id/repeatButton"
            android:nextFocusUp="@+id/backButton"
            android:nextFocusDown="@+id/searchInput"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />
    </LinearLayout>

    <!-- Search row: IME actionSearch on the field plus explicit D-pad «Найти» and the
         two branch tabs «Для тебя»/«Чарты» — the remote user never depends on the soft
         keyboard being reachable. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/tv_music_row_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/searchInput"
            android:hint="Поиск треков…"
            android:textColor="@color/mars_text"
            android:textColorHint="@color/mars_muted"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="text"
            android:background="@drawable/bg_focus_input"
            android:padding="16dp"
            android:focusable="true"
            android:imeOptions="actionSearch"
            android:nextFocusLeft="@+id/searchInput"
            android:nextFocusRight="@+id/searchButton"
            android:nextFocusUp="@+id/backButton"
            android:nextFocusDown="@+id/trackList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/tv_music_control_h" />

        <Button
            android:id="@+id/searchButton"
            android:text="Найти"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_accent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@+id/searchInput"
            android:nextFocusRight="@+id/forYouButton"
            android:nextFocusUp="@+id/repeatButton"
            android:nextFocusDown="@+id/trackList"
            android:layout_marginStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />

        <!-- Вкладка «Для тебя»: персональная лента /api/home (паритет с мобильной). -->
        <Button
            android:id="@+id/forYouButton"
            android:text="@string/tv_music_tab_for_you"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@+id/searchButton"
            android:nextFocusRight="@+id/chartsButton"
            android:nextFocusUp="@+id/stopButton"
            android:nextFocusDown="@+id/trackList"
            android:layout_marginStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />

        <Button
            android:id="@+id/chartsButton"
            android:text="@string/tv_music_tab_charts"
            android:textSize="18sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@+id/forYouButton"
            android:nextFocusRight="@+id/chartsButton"
            android:nextFocusUp="@+id/stopButton"
            android:nextFocusDown="@+id/trackList"
            android:layout_marginStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_music_control_h" />
    </LinearLayout>

    <TextView
        android:id="@+id/stateText"
        android:text="Загрузка треков…"
        android:textColor="@color/mars_muted"
        android:textSize="24sp"
        android:accessibilityLiveRegion="polite"
        android:layout_marginTop="@dimen/tv_music_row_gap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/retryButton"
        android:text="Повторить"
        android:textSize="20sp"
        android:textColor="@color/mars_text"
        android:background="@drawable/bg_focus_accent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:gravity="center"
        android:focusable="true"
        android:visibility="gone"
        android:nextFocusLeft="@+id/searchInput"
        android:nextFocusRight="@+id/chartsButton"
        android:nextFocusUp="@+id/searchInput"
        android:nextFocusDown="@+id/trackList"
        android:layout_marginTop="@dimen/tv_music_row_gap"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tv_music_control_h" />

    <ScrollView
        android:layout_marginTop="@dimen/tv_music_row_gap"
        android:scrollbars="none"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:id="@+id/trackList"
            android:orientation="vertical"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
