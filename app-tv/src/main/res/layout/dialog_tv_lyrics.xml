<?xml version="1.0" encoding="utf-8"?>
<!-- Панель «Текст песни» (диалог): Dark Obsidian + Ruby, D-pad фокус, только цвета темы, без эмодзи.
     Кегли — только AppText.*, отступы и высоты — из dimens.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_card_pad"
    android:paddingBottom="@dimen/tv_card_pad"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/lyricsTitleText"
        android:text="Текст песни"
        android:textAppearance="@style/AppText.Title"
        android:textColor="@color/mars_text_strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/lyricsTrackText"
        android:textAppearance="@style/AppText.Body"
        android:textColor="@color/mars_accent_text"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/tv_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/lyricsMetaText"
        android:textAppearance="@style/AppText.Label"
        android:textColor="@color/mars_muted"
        android:visibility="gone"
        android:layout_marginTop="@dimen/tv_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- D-pad-скролл текста: ScrollView фокусируемый, стрелки листают куплеты. -->
    <ScrollView
        android:id="@+id/lyricsScroll"
        android:scrollbars="none"
        android:focusable="true"
        android:layout_marginTop="@dimen/tv_gap_l"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <TextView
            android:id="@+id/lyricsBodyText"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_muted"
            android:lineSpacingExtra="@dimen/tv_gap_xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <!-- Нижний ряд: «Перевод»/«Оригинал» (видим только при настоящем тексте) и «Закрыть».
         Цепочку LEFT/RIGHT переподключает код по видимости (TvMusicActivity.renderTranslateButton). -->
    <LinearLayout
        android:id="@+id/lyricsButtonRow"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/tv_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_pair_field_h">

        <Button
            android:id="@+id/lyricsTranslateButton"
            android:text="@string/tv_lyrics_action_translate"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="@dimen/tv_screen_pad_h"
            android:paddingEnd="@dimen/tv_screen_pad_h"
            android:gravity="center"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/lyricsCloseButton"
            android:text="Закрыть"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="@dimen/tv_screen_pad_h"
            android:paddingEnd="@dimen/tv_screen_pad_h"
            android:gravity="center"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
