<?xml version="1.0" encoding="utf-8"?>
<!-- Экран живых метрик проектов (TV P1). Состояния: loading / error / data (host + services).
     Без заглушки «Онлайн»: статус выводится из данных, недоступность отображается явно.
     statusView — accessibility live region (polite): обновления и ошибки объявляются голосом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Проекты"
            android:textColor="@color/mars_text_strong"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:text="Загрузка метрик…"
            android:textColor="@color/mars_muted"
            android:textSize="18sp"
            android:gravity="end"
            android:maxWidth="420dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:layout_marginStart="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_header_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Состояние: загрузка -->
        <LinearLayout
            android:id="@+id/loadingGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:indeterminateTint="@color/mars_accent"
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:text="Загрузка метрик…"
                android:textColor="@color/mars_muted"
                android:textSize="20sp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние: ошибка (явная недоступность данных) -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:src="@drawable/ic_status_dot_error"
                android:contentDescription="@null"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/errorText"
                android:textColor="@color/mars_status_error"
                android:textSize="24sp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/retryButton"
                android:text="Повторить"
                android:textSize="20sp"
                android:textColor="@color/mars_text"
                android:background="@drawable/bg_focus_card"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/icon_focus_tint"
                android:drawablePadding="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:layout_marginTop="22dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Состояние: данные (хост + сервисы) -->
        <ScrollView
            android:id="@+id/dataScroll"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
