<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка профиля (TV, read-only): подпись, бейджи состояния, мета
     (модель, провайдер, навыки) и путь. Карточка фокусируема и кликабельна:
     OK на пульте открывает чат этого профиля (TvProfilesPolicy.canOpenChat).
     Никаких мутаций профиля на карточке нет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_focus_card"
    android:padding="24dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_marginTop="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/profileTitle"
            android:textColor="@color/mars_text_strong"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileActiveBadge"
            android:text="Активный"
            android:textColor="@color/mars_status_online"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileDefaultBadge"
            android:text="По умолчанию"
            android:textColor="@color/mars_status_info"
            android:textSize="18sp"
            android:visibility="gone"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileHiddenBadge"
            android:text="Скрыт"
            android:textColor="@color/mars_status_warning"
            android:textSize="18sp"
            android:visibility="gone"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileMeta"
        android:textColor="@color/mars_text_em"
        android:textSize="20sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/profilePath"
        android:textColor="@color/mars_muted"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="middle"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
