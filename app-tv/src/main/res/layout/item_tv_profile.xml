<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка профиля (TV, read-only): подпись, бейджи состояния, мета
     (модель, провайдер, навыки) и путь. Карточка фокусируема и кликабельна:
     OK на пульте открывает чат этого профиля (TvProfilesPolicy.canOpenChat).
     Никаких мутаций профиля на карточке нет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_focus_card"
    android:padding="@dimen/tv_card_pad"
    android:focusable="true"
    android:clickable="true"
    android:layout_marginTop="@dimen/tv_card_gap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/profileTitle"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Title"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileActiveBadge"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Активный"
            android:textColor="@color/mars_status_online"
            android:textAppearance="@style/AppText.Body"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginStart="@dimen/tv_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileDefaultBadge"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="По умолчанию"
            android:textColor="@color/mars_status_info"
            android:textAppearance="@style/AppText.Body"
            android:visibility="gone"
            android:layout_marginStart="@dimen/tv_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileHiddenBadge"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Скрыт"
            android:textColor="@color/mars_status_warning"
            android:textAppearance="@style/AppText.Body"
            android:visibility="gone"
            android:layout_marginStart="@dimen/tv_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileMeta"
        android:textColor="@color/mars_text_em"
        android:textAppearance="@style/AppText.Body"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/profilePath"
        android:textColor="@color/mars_muted_on_glass"
        android:textAppearance="@style/AppText.Label"
        android:maxLines="1"
        android:ellipsize="middle"
        android:visibility="gone"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
