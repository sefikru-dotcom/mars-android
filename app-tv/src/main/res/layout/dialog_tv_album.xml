<?xml version="1.0" encoding="utf-8"?>
<!--
  Альбом на TV (диалог): заголовок, мета, D-pad-список треков, «Закрыть».
  Минимальный вариант брифа: полноценный экран не нужен, но список обязан листаться
  пультом, поэтому треки живут в фокусируемом ScrollView, а состояния
  «загрузка/нет сети/не найден» печатаются в том же теле (см. TvMusicActivity.renderAlbumPanel).
  Цвета — только из темы (MarsTheme parity), без эмодзи. Кегли — только AppText.*.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_card_pad"
    android:paddingBottom="@dimen/tv_card_pad"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/albumTitleText"
        android:text="@string/tv_album_title"
        android:textAppearance="@style/AppText.Title"
        android:textColor="@color/mars_text_strong"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/albumMetaText"
        android:textAppearance="@style/AppText.Body"
        android:textColor="@color/mars_accent_text"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:layout_marginTop="@dimen/tv_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Состояние запроса (загрузка / отказ / пусто) — то же место, что тело текста песни. -->
    <TextView
        android:id="@+id/albumStateText"
        android:textAppearance="@style/AppText.Body"
        android:textColor="@color/mars_muted"
        android:visibility="gone"
        android:layout_marginTop="@dimen/tv_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- D-pad-скролл треков: сам ScrollView фокусируемый, строки внутри — тоже. -->
    <ScrollView
        android:id="@+id/albumScroll"
        android:scrollbars="none"
        android:focusable="true"
        android:layout_marginTop="@dimen/tv_gap_m"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:id="@+id/albumTrackList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/tv_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_pair_field_h">

        <!-- «Повторить» живёт только у сетевого отказа: у «не найден» повтор бессмыслен
             (TvAlbumPolicy.retryVisible), и мёртвая кнопка не должна ловить фокус. -->
        <Button
            android:id="@+id/albumRetryButton"
            android:text="@string/tv_album_retry"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="@dimen/tv_screen_pad_h"
            android:paddingEnd="@dimen/tv_screen_pad_h"
            android:gravity="center"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/albumCloseButton"
            android:text="@string/tv_album_close"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:paddingStart="@dimen/tv_screen_pad_h"
            android:paddingEnd="@dimen/tv_screen_pad_h"
            android:gravity="center"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
