<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка скилла (TV, read-only): имя + бейдж «использован N раз»,
     ниже категория и описание. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_focus_card"
    android:padding="@dimen/tv_card_pad"
    android:focusable="true"
    android:layout_marginTop="@dimen/tv_card_gap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/skillName"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Title"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/skillBadge"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/mars_status_online"
            android:textAppearance="@style/AppText.Body"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/skillCategory"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/mars_accent_text"
        android:textAppearance="@style/AppText.Label"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/skillDescription"
        android:textColor="@color/mars_muted_on_glass"
        android:textAppearance="@style/AppText.Body"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/tv_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
