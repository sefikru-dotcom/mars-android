<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка «Задачи»: статусная точка (тонизируется в коде по семантике),
     текст задачи (completed — зачёркнут, in_progress — акцент), справа бейдж статуса. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_focus_card"
    android:padding="@dimen/tv_card_pad"
    android:focusable="true"
    android:layout_marginTop="@dimen/tv_card_gap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/todoDot"
        android:src="@drawable/ic_status_dot"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/tv_gap_xs"
        android:layout_width="12dp"
        android:layout_height="12dp" />

    <TextView
        android:id="@+id/todoContent"
        android:textColor="@color/mars_text"
        android:textAppearance="@style/AppText.Body"
        android:lineSpacingExtra="@dimen/tv_gap_xs"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/tv_gap_l"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/todoBadge"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/AppText.Label"
        android:background="@drawable/bg_chip"
        android:paddingStart="@dimen/tv_gap_m"
        android:paddingEnd="@dimen/tv_gap_m"
        android:paddingTop="@dimen/tv_gap_xs"
        android:paddingBottom="@dimen/tv_gap_xs"
        android:layout_marginStart="@dimen/tv_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
