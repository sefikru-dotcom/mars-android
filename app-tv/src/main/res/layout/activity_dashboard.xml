<?xml version="1.0" encoding="utf-8"?>
<!-- TV dashboard: Dark Obsidian + Ruby, D-pad focused, 540dp vertical budget (Mi TV 960x540dp).

     ИЕРАРХИЯ (не «однородная каша»): часы 40 (AppText.Display) > заголовок «Марс» 28
     (AppText.Headline) > подписи кнопок 20 (AppText.Title) > тело/мета 16/14
     (AppText.Body / AppText.Label). Часы больше НЕ крупнейший элемент экрана:
     раньше 48sp при заголовке 28sp задавали «гигантоманию» шапки.

     ПЛОТНОСТЬ: шапка одной строкой, лента плеера на всю ширину, сетка 4x3 на
     layout_weight (ряды делят остаток высоты поровну, кнопки видны всегда, без скролла;
     при показанном мини-плеере ряды автоматически становятся компактнее).

     КАРТОЧКИ: @drawable/bg_card_glass — 72% заливка + 1dp рамка, рубиновый селектор
     фокуса D-pad (state_focused). Прозрачность не ломает контраст: фон-слой
     bg_tv_root сам несёт плотный scrim, альфа заливки ниже токена не опускается.

     Все размеры — токены res/values/dimens.xml, кегли — только AppText.*.
     Все id и цепочки nextFocus сохранены — их читает DashboardActivity.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Шапка: логотип+имя слева, статус-слот в центре, часы+дата справа (одна строка) -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/ic_mars"
            android:contentDescription="@null"
            android:layout_width="@dimen/tv_dash_logo"
            android:layout_height="@dimen/tv_dash_logo" />

        <TextView
            android:text="Марс"
            android:textAppearance="@style/AppText.Headline"
            android:maxLines="1"
            android:ellipsize="end"
            android:minWidth="0dp"
            android:layout_marginStart="@dimen/tv_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Статус-слот шапки: занимает середину строки, поэтому часы всегда прижаты
             к правому краю, а заголовок — к левому, независимо от наличия текста.
             Текст пишется только по факту (последнее событие/короткий статус), по
             умолчанию пусто и gone — слот при этом сохраняет ширину за счёт weight. -->
        <LinearLayout
            android:id="@+id/headerStatusSlot"
            android:orientation="horizontal"
            android:gravity="center_vertical|start"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minWidth="0dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/headerStatus"
                android:textAppearance="@style/AppText.Label"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:minWidth="0dp"
                android:visibility="gone"
                android:layout_marginStart="@dimen/tv_gap_l"
                android:layout_marginEnd="@dimen/tv_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="end"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/time"
                android:textAppearance="@style/AppText.Display"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/dateLine"
                android:textAppearance="@style/AppText.Label"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/tv_gap_xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Now-playing strip: mirrors the global TvMusicPlayer transport while a track is bound;
         rules (visibility/caption/toggle label) live in TvMiniPlayerSpec. Gone when idle.
         Ширина match_parent: заголовок трека забирает весь остаток (weight), кнопка
         транспорта прижата к правому краю — правая половина больше не пустует. -->
    <LinearLayout
        android:id="@+id/nowPlayingRow"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_dash_now_margin"
        android:paddingStart="@dimen/tv_gap_l"
        android:paddingEnd="@dimen/tv_gap_m"
        android:paddingTop="@dimen/tv_dash_now_pad_v"
        android:paddingBottom="@dimen/tv_dash_now_pad_v"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/ic_music"
            android:contentDescription="@null"
            app:tint="@color/mars_muted"
            android:layout_marginEnd="@dimen/tv_gap_m"
            android:layout_width="@dimen/tv_icon_m"
            android:layout_height="@dimen/tv_icon_m" />

        <TextView
            android:id="@+id/nowPlayingText"
            android:textAppearance="@style/AppText.Body"
            android:maxLines="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:minWidth="0dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/nowPlayingToggle"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:paddingTop="@dimen/tv_gap_xs"
            android:paddingBottom="@dimen/tv_gap_xs"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_pause"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:text="Пауза"
            android:textAppearance="@style/AppText.Body"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:nextFocusDown="@id/chatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Сетка разделов 4 ряда x 3: ряды height=0dp+weight=1 делят остаток высоты экрана,
         кнопки match_parent внутри ряда. Все 11 кнопок видны на 540dp без скролла.
         Кнопка = стеклянная карточка: bg_card_glass, подпись AppText.Title,
         паддинги и иконка из токенов tv_dash_btn_* / tv_icon_m. -->
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_dash_grid_gap_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/chatButton"
            android:text="Чат"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_chat"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusRight="@id/projectsButton"
            android:nextFocusDown="@id/musicButton"
            android:nextFocusUp="@id/nowPlayingToggle"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/projectsButton"
            android:text="Проекты"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_projects"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/chatButton"
            android:nextFocusRight="@id/todosButton"
            android:nextFocusDown="@id/cronButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/todosButton"
            android:text="Задачи"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_todos"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/projectsButton"
            android:nextFocusDown="@id/settingsButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_dash_row_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/musicButton"
            android:text="Музыка"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_music"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusRight="@id/cronButton"
            android:nextFocusUp="@id/chatButton"
            android:nextFocusDown="@id/kanbanButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/cronButton"
            android:text="Cron"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_cron"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/musicButton"
            android:nextFocusRight="@id/settingsButton"
            android:nextFocusUp="@id/projectsButton"
            android:nextFocusDown="@id/insightsButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/settingsButton"
            android:text="Выход"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_settings"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/cronButton"
            android:nextFocusUp="@id/todosButton"
            android:nextFocusDown="@id/spacesButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_dash_row_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/kanbanButton"
            android:text="Канбан"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_kanban"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusRight="@id/insightsButton"
            android:nextFocusUp="@id/musicButton"
            android:nextFocusDown="@id/memoryButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/insightsButton"
            android:text="Аналитика"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_insights"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/kanbanButton"
            android:nextFocusRight="@id/spacesButton"
            android:nextFocusUp="@id/cronButton"
            android:nextFocusDown="@id/skillsButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/spacesButton"
            android:text="Пространства"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_spaces"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/insightsButton"
            android:nextFocusUp="@id/settingsButton"
            android:nextFocusDown="@id/profilesButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_dash_row_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/memoryButton"
            android:text="Память"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_memory"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusRight="@id/skillsButton"
            android:nextFocusUp="@id/kanbanButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/skillsButton"
            android:text="Скиллы"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_skills"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/memoryButton"
            android:nextFocusRight="@id/profilesButton"
            android:nextFocusUp="@id/insightsButton"
            android:layout_marginEnd="@dimen/tv_dash_btn_col_gap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/profilesButton"
            android:text="Профили"
            android:textAppearance="@style/AppText.Title"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@drawable/ic_profiles"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_dash_btn_drawable_gap"
            android:paddingStart="@dimen/tv_dash_btn_pad_h"
            android:paddingEnd="@dimen/tv_dash_btn_pad_h"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="@dimen/tv_dash_btn_min_h"
            android:focusable="true"
            android:nextFocusLeft="@id/skillsButton"
            android:nextFocusUp="@id/spacesButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
