<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="52dp"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/ic_mars"
            android:contentDescription="@null"
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <TextView
            android:text="Марс"
            android:textColor="@color/mars_text_strong"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Без статичного «Марс онлайн»: доступность сервера здесь не проверяется,
         живой статус показывают экраны Чат/Проекты/Задачи/Cron из реальных данных. -->
    <TextView
        android:id="@+id/time"
        android:text="00:00"
        android:textColor="@color/mars_text"
        android:textSize="54sp"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Secondary clock line: full weekday + date (format decisions in TvDashboardClockSpec).
         Muted and smaller than HH:mm — the hierarchy is time first, date second. -->
    <TextView
        android:id="@+id/dateLine"
        android:textColor="@color/mars_muted"
        android:textSize="20sp"
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Now playing plate: mirrors the global TvMusicPlayer transport while a track is
         bound (rules: TvMiniPlayerSpec — same spec the chat header mini player uses).
         D-pad reachable: UP from «Чат» lands on the toggle, DOWN returns to the grid.
         Gone when the transport is idle, so the grid keeps its usual focus chains. -->
    <LinearLayout
        android:id="@+id/nowPlayingRow"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip"
        android:layout_marginTop="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/ic_music"
            android:contentDescription="@null"
            app:tint="@color/mars_muted"
            android:layout_marginEnd="12dp"
            android:layout_width="26dp"
            android:layout_height="26dp" />

        <TextView
            android:id="@+id/nowPlayingText"
            android:textColor="@color/mars_text"
            android:textSize="18sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/nowPlayingToggle"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_pause"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="8dp"
            android:text="Пауза"
            android:textColor="@color/mars_text"
            android:textSize="16sp"
            android:nextFocusDown="@id/chatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Сетка кнопок 3x2: явные D-pad цепочки по строкам и столбцам, без wrap. -->
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="44dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/chatButton"
            android:text="Чат"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_chat"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusUp="@id/nowPlayingToggle"
            android:nextFocusRight="@id/projectsButton"
            android:nextFocusDown="@id/musicButton"
            android:layout_marginEnd="16dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />

        <Button
            android:id="@+id/projectsButton"
            android:text="Проекты"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_projects"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@id/chatButton"
            android:nextFocusRight="@id/todosButton"
            android:nextFocusDown="@id/cronButton"
            android:layout_marginEnd="16dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />

        <Button
            android:id="@+id/todosButton"
            android:text="Задачи"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_todos"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusLeft="@id/projectsButton"
            android:nextFocusDown="@id/settingsButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/musicButton"
            android:text="Музыка"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_music"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusUp="@id/chatButton"
            android:nextFocusRight="@id/cronButton"
            android:layout_marginEnd="16dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />

        <Button
            android:id="@+id/cronButton"
            android:text="Cron"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_cron"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusUp="@id/projectsButton"
            android:nextFocusLeft="@id/musicButton"
            android:nextFocusRight="@id/settingsButton"
            android:layout_marginEnd="16dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />

        <Button
            android:id="@+id/settingsButton"
            android:text="Настройки / выход"
            android:textSize="22sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_settings"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:nextFocusUp="@id/todosButton"
            android:nextFocusLeft="@id/cronButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="96dp" />
    </LinearLayout>
</LinearLayout>
