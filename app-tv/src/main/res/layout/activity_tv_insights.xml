<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Аналитика» (TV, read-only): табы Аналитика/Логи.
     Аналитика — GET /api/insights (чипы периода 1/7/30/90, строки-ряды);
     Логи — GET /api/logs (чипы файла и хвоста, моноширинные строки окна).
     Каждая вкладка имеет собственные состояния loading/error/data;
     statusView — accessibility live region (polite). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="40dp"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/refreshButton"
            android:nextFocusDown="@id/tabInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Аналитика"
            android:textColor="@color/mars_text_strong"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:text="Загрузка аналитики…"
            android:textColor="@color/mars_muted"
            android:textSize="18sp"
            android:gravity="end"
            android:maxWidth="560dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textSize="20sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:nextFocusDown="@id/tabLogs"
            android:layout_marginStart="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Табы вкладки: Аналитика / Логи (D-pad left/right) -->
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/tabInsights"
            android:text="Аналитика"
            android:textSize="17sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:nextFocusUp="@id/backButton"
            android:nextFocusRight="@id/tabLogs"
            android:layout_marginEnd="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tabLogs"
            android:text="Логи"
            android:textSize="17sp"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:nextFocusUp="@id/refreshButton"
            android:nextFocusLeft="@id/tabInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ══ Вкладка «Аналитика» ══ -->
    <LinearLayout
        android:id="@+id/insightsPane"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Чипы периода (1/7/30/90 дней) — наполняются в коде из TvInsightsPolicy -->
        <LinearLayout
            android:id="@+id/periodChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/insightsLoading"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:indeterminateTint="@color/mars_accent"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <TextView
                    android:text="Загрузка аналитики…"
                    android:textColor="@color/mars_muted"
                    android:textSize="20sp"
                    android:layout_marginTop="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insightsError"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_status_dot_error"
                    android:contentDescription="@null"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/insightsErrorText"
                    android:textColor="@color/mars_status_error"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:layout_marginTop="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/insightsRetryButton"
                    android:text="Повторить"
                    android:textSize="20sp"
                    android:textColor="@color/mars_text"
                    android:background="@drawable/bg_focus_card"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/icon_focus_tint"
                    android:drawablePadding="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:focusable="true"
                    android:layout_marginTop="22dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/insightsScroll"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/insightsRowsContainer"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ══ Вкладка «Логи» ══ -->
    <LinearLayout
        android:id="@+id/logsPane"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        android:layout_marginTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Чипы файла (Агент/Ошибки/Шлюз) и хвоста (100/200/500/1000) — из кода -->
        <LinearLayout
            android:id="@+id/logFileChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/logTailChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/logsLoading"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:indeterminateTint="@color/mars_accent"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <TextView
                    android:text="Загрузка логов…"
                    android:textColor="@color/mars_muted"
                    android:textSize="20sp"
                    android:layout_marginTop="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/logsError"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_status_dot_error"
                    android:contentDescription="@null"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/logsErrorText"
                    android:textColor="@color/mars_status_error"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:layout_marginTop="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/logsRetryButton"
                    android:text="Повторить"
                    android:textSize="20sp"
                    android:textColor="@color/mars_text"
                    android:background="@drawable/bg_focus_card"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/icon_focus_tint"
                    android:drawablePadding="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:focusable="true"
                    android:layout_marginTop="22dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logsScroll"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/logsMeta"
                        android:textColor="@color/mars_text_em"
                        android:textSize="17sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/logsEmptyText"
                        android:visibility="gone"
                        android:textColor="@color/mars_muted"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/logsLinesContainer"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
