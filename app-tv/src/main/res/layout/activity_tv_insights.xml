<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Аналитика» (TV, read-only): табы Аналитика/Логи.
     Аналитика — GET /api/insights (чипы периода 1/7/30/90, строки-ряды);
     Логи — GET /api/logs (чипы файла и хвоста, моноширинные строки окна).
     Каждая вкладка имеет собственные состояния loading/error/data;
     statusView — accessibility live region (polite). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_pad_h"
    android:paddingEnd="@dimen/tv_screen_pad_h"
    android:paddingTop="@dimen/tv_screen_pad_top"
    android:paddingBottom="@dimen/tv_screen_pad_bottom"
    android:background="@drawable/bg_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="Назад"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusRight="@id/refreshButton"
            android:nextFocusDown="@id/tabInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:minWidth="@dimen/tv_title_min_w"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Аналитика"
            android:textColor="@color/mars_text_strong"
            android:textAppearance="@style/AppText.Headline"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/statusView"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Загрузка аналитики…"
            android:textColor="@color/mars_muted"
            android:textAppearance="@style/AppText.Body"
            android:gravity="end"
            android:maxWidth="560dp"
            android:accessibilityLiveRegion="polite"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refreshButton"
            android:text="Обновить"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_refresh"
            android:drawableTint="@color/icon_focus_tint"
            android:drawablePadding="@dimen/tv_gap_s"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_l"
            android:paddingEnd="@dimen/tv_gap_l"
            android:paddingTop="@dimen/tv_gap_m"
            android:paddingBottom="@dimen/tv_gap_m"
            android:focusable="true"
            android:nextFocusLeft="@id/backButton"
            android:nextFocusDown="@id/tabLogs"
            android:layout_marginStart="@dimen/tv_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Табы вкладки: Аналитика / Логи (D-pad left/right) -->
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_header_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/tabInsights"
            android:text="Аналитика"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/backButton"
            android:nextFocusRight="@id/tabLogs"
            android:layout_marginEnd="@dimen/tv_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tabLogs"
            android:text="Логи"
            android:textAppearance="@style/AppText.Body"
            android:textColor="@color/mars_text"
            android:background="@drawable/bg_focus_chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/tv_gap_m"
            android:paddingEnd="@dimen/tv_gap_m"
            android:paddingTop="@dimen/tv_gap_s"
            android:paddingBottom="@dimen/tv_gap_s"
            android:focusable="true"
            android:nextFocusUp="@id/refreshButton"
            android:nextFocusLeft="@id/tabInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ══ Вкладка «Аналитика» ══ -->
    <LinearLayout
        android:id="@+id/insightsPane"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/tv_header_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Чипы периода (1/7/30/90 дней) — наполняются в коде из TvInsightsPolicy -->
        <LinearLayout
            android:id="@+id/periodChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="@dimen/tv_header_gap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/insightsLoading"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:indeterminateTint="@color/mars_accent"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Загрузка аналитики…"
                    android:textColor="@color/mars_muted"
                    android:textAppearance="@style/AppText.Body"
                    android:layout_marginTop="@dimen/tv_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insightsError"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_status_dot_error"
                    android:contentDescription="@null"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/insightsErrorText"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/mars_status_error"
                    android:textAppearance="@style/AppText.Title"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:layout_marginTop="@dimen/tv_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/insightsRetryButton"
                    android:text="Повторить"
                    android:textAppearance="@style/AppText.Body"
                    android:textColor="@color/mars_text"
                    android:background="@drawable/bg_focus_card"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/icon_focus_tint"
                    android:drawablePadding="@dimen/tv_gap_s"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="@dimen/tv_gap_xl"
                    android:paddingEnd="@dimen/tv_gap_xl"
                    android:paddingTop="@dimen/tv_gap_m"
                    android:paddingBottom="@dimen/tv_gap_m"
                    android:focusable="true"
                    android:layout_marginTop="@dimen/tv_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/insightsScroll"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/insightsRowsContainer"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/tv_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ══ Вкладка «Логи» ══ -->
    <LinearLayout
        android:id="@+id/logsPane"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        android:layout_marginTop="@dimen/tv_header_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Чипы файла (Агент/Ошибки/Шлюз) и хвоста (100/200/500/1000) — из кода -->
        <LinearLayout
            android:id="@+id/logFileChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/logTailChipsContainer"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="@dimen/tv_gap_s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="@dimen/tv_header_gap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/logsLoading"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:indeterminateTint="@color/mars_accent"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Загрузка логов…"
                    android:textColor="@color/mars_muted"
                    android:textAppearance="@style/AppText.Body"
                    android:layout_marginTop="@dimen/tv_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/logsError"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_status_dot_error"
                    android:contentDescription="@null"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/logsErrorText"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/mars_status_error"
                    android:textAppearance="@style/AppText.Title"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:layout_marginTop="@dimen/tv_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/logsRetryButton"
                    android:text="Повторить"
                    android:textAppearance="@style/AppText.Body"
                    android:textColor="@color/mars_text"
                    android:background="@drawable/bg_focus_card"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/icon_focus_tint"
                    android:drawablePadding="@dimen/tv_gap_s"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="@dimen/tv_gap_xl"
                    android:paddingEnd="@dimen/tv_gap_xl"
                    android:paddingTop="@dimen/tv_gap_m"
                    android:paddingBottom="@dimen/tv_gap_m"
                    android:focusable="true"
                    android:layout_marginTop="@dimen/tv_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logsScroll"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/tv_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/logsMeta"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/mars_text_em"
                        android:textAppearance="@style/AppText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/logsEmptyText"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:visibility="gone"
                        android:textColor="@color/mars_muted"
                        android:textAppearance="@style/AppText.Body"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/tv_gap_xl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/logsLinesContainer"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginTop="@dimen/tv_gap_s"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
