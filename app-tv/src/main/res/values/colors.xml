<?xml version="1.0" encoding="utf-8"?>
<!-- Mars WebUI Design System parity: Dark Obsidian + Ruby. No emojis. -->
<resources>
    <!-- Base palette (MarsTheme) -->
    <color name="mars_background">#07080B</color>
    <color name="mars_sidebar">#0C0E14</color>
    <color name="mars_surface">#10131B</color>
    <color name="mars_surface_subtle">#141822</color>
    <color name="mars_surface_card">#161B28</color>

    <!-- Borders -->
    <color name="mars_border">#212634</color>
    <color name="mars_border_subtle">#171C26</color>
    <color name="mars_border_muted">#283042</color>

    <!-- Ruby accent -->
    <color name="mars_accent">#EF4444</color>
    <color name="mars_accent_hover">#F87171</color>
    <color name="mars_accent_bg">#26EF4444</color>
    <color name="mars_accent_bg_pressed">#33EF4444</color>
    <color name="mars_accent_text">#FCA5A5</color>
    <color name="mars_on_accent">#0B0D12</color>

    <!-- Text -->
    <color name="mars_text">#F1F5F9</color>
    <color name="mars_text_strong">#FFFFFF</color>
    <color name="mars_muted">#9AA5B4</color>
    <color name="mars_text_em">#CBD5E1</color>
    <!-- Алиас имени, которым этот же тон зовёт app-mobile (mars_em): без пары
         один и тот же оттенок назывался по-разному в двух модулях, и сверка
         палитр не могла их сопоставить. -->
    <color name="mars_em">#CBD5E1</color>

    <!-- Chat bubbles -->
    <color name="mars_user_bubble">#1C2436</color>
    <color name="mars_user_border">#2B374E</color>
    <color name="mars_bot_card">#0F121A</color>
    <color name="mars_bot_border">#1B2230</color>

    <!-- Status -->
    <color name="mars_status_online">#22C55E</color>
    <color name="mars_status_error">#EF4444</color>
    <color name="mars_status_warning">#F59E0B</color>
    <color name="mars_status_info">#38BDF8</color>

    <!-- Session browser overlay scrim (85% of the base background) -->
    <color name="mars_scrim">#D907080B</color>

    <!-- ═══ Стекло поверх фона с планетой ═══
         Заливка 72% альфы от surface (было 78%): планета просвечивает
         сильнее, как просил владелец. Focus — светлее + рубиновая рамка.

         Плотность выбрана по замеру, а не на глаз. Новый фон (апскейл
         600x337 -> 1920x1080) на самом светлом участке под карточками
         даёт 153/135/116. При альфе 184 (72%) композит выходит 55/52/52:
         рубиновый акцент #EF4444 держит 3.33 (порог WCAG для крупных
         элементов — 3.0), его hover #F87171 — 4.52, тело #F1F5F9 — 11.49.
         При 66% акцент падал до 2.99 — ровно на границе, поэтому взят 72%.
         Меньше нельзя без смены акцента на более светлый. -->
    <color name="mars_glass_fill">#B010131B</color>
    <color name="mars_glass_fill_focused">#CC161C28</color>
    <color name="mars_glass_stroke">#33FFFFFF</color>

    <!-- Затемняющий слой над фотографией фона: держит контраст текста
         независимо от яркости участка Марса под ним. -->
    <color name="mars_bg_scrim">#E007080B</color>
    <color name="mars_bg_scrim_soft">#9907080B</color>
</resources>
