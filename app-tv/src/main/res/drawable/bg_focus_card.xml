<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad focus for surface cards: smooth ruby border + tinted background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="180"
    android:exitFadeDuration="220">

    <item android:state_focused="true" android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mars_accent_bg_pressed" />
                    <corners android:radius="16dp" />
                    <stroke android:width="3dp" android:color="@color/mars_accent_hover" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <!-- Ambient ruby glow behind the card -->
            <item android:left="-3dp" android:top="-3dp" android:right="-3dp" android:bottom="-3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="18dp" />
                    <stroke android:width="3dp" android:color="@color/mars_accent_bg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mars_accent_bg" />
                    <corners android:radius="16dp" />
                    <stroke android:width="2dp" android:color="@color/mars_accent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_surface_subtle" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/mars_border_muted" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/mars_border" />
        </shape>
    </item>
</selector>
