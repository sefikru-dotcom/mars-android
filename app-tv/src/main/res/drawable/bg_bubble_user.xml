<?xml version="1.0" encoding="utf-8"?>
<!-- Focusable chat bubble: user side. Ruby border lights up under D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="180"
    android:exitFadeDuration="220">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_user_bubble" />
            <corners android:radius="@dimen/tv_card_corner" />
            <stroke android:width="2dp" android:color="@color/mars_accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_user_bubble" />
            <corners android:radius="@dimen/tv_card_corner" />
            <stroke android:width="@dimen/tv_card_stroke" android:color="@color/mars_user_border" />
        </shape>
    </item>
</selector>
