<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad focus for sidebar items: subtle ruby wash + left-aligned border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="180"
    android:exitFadeDuration="220">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_accent_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/mars_accent" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_sidebar" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/mars_border_muted" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
