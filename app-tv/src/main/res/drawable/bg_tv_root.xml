<?xml version="1.0" encoding="utf-8"?>
<!-- Фон ТВ-клиента Марса: планета под слоями затемнения.

     Порядок слоёв критичен: bitmap идёт ПЕРВЫМ (нижним), иначе он перекроет
     затемнение и вместе с ним весь интерфейс. Порядок держит тест
     TvBackgroundLayerTest.

     Почему drawable-nodpi: снимок 1920x1080 не должен масштабироваться по
     плотности экрана. nodpi кладёт его 1:1, а растяжение под фактические
     размеры вью делает layer-list — поэтому 1080p и 4K получают одно и то же
     кадрирование без повторной пересэмплировки по density bucket.

     Геометрия кадра: планета занимает нижнюю половину, её светящийся лимб
     приходится на середину по вертикали. Карточки ТВ лежат поверх всей
     площади, поэтому затемнение распределено по вертикали, а не по
     горизонтали — как было у прежнего фона с планетой справа.

     Важно: основное затемнение уже впечено в сам JPEG (там же, где апскейл).
     Слои ниже — только выравнивание краёв и виньетка. Если сюда добавить
     плотную заливку, она сложится с впечённой и фон станет вдвое темнее. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 0. Фотография. gravity="fill" — единственный способ растянуть кадр под
         фактические размеры экрана: у <bitmap> в layer-list нет centerCrop
         (AAPT: "'centerCrop' is incompatible with attribute gravity"), есть
         только флаги Gravity. Искажения нет: исходник 16:9 и целевой экран
         16:9 (1080p/4K), nodpi отдаёт снимок 1:1 без density-пересэмплинга. -->
    <item>
        <bitmap
            android:src="@drawable/bg_mars_photo"
            android:gravity="fill" />
    </item>

    <!-- 1. Лёгкая виньетка с центром на планете (0.50/0.74). Ровного scrim
         здесь нет намеренно: он дублировал затемнение, уже впечённое в JPEG,
         и вдвоём они гасили кадр так, что планета пропадала. Один слой —
         один эффект. Радиус 95%p: тёмное кольцо не должно подступать к лимбу,
         это главный светлый акцент кадра. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="95%p"
                android:centerX="0.50"
                android:centerY="0.74"
                android:startColor="#0D0F1420"
                android:endColor="#4D07080B" />
        </shape>
    </item>
</layer-list>
