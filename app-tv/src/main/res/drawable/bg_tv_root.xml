<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Radial obsidian vignette: deeper edges, slightly lifted center -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mars_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.5"
                android:centerY="0.38"
                android:startColor="#141A26"
                android:endColor="#07080B" />
        </shape>
    </item>
</layer-list>
